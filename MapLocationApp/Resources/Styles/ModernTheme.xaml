<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ==================== WYGINS+ INSPIRED DESIGN SYSTEM ==================== -->
    <!-- Warm cream background + retro tile palette + decorative serif typography -->

    <!-- ==================== COLOR PALETTE ==================== -->

    <!-- Primary action — vermillion orange (matches the icon's phone outline) -->
    <Color x:Key="ModernPrimary">#E96B3C</Color>
    <Color x:Key="ModernPrimaryHover">#D85A2D</Color>
    <Color x:Key="ModernPrimaryLight">#FCD9C8</Color>
    <Color x:Key="ModernPrimaryLighter">#FFF1E8</Color>
    <Color x:Key="ModernPrimaryDark">#B84A26</Color>

    <!-- Secondary — lavender (icon's checkmark accent) -->
    <Color x:Key="ModernSecondary">#A88BC6</Color>
    <Color x:Key="ModernSecondaryHover">#9776B4</Color>
    <Color x:Key="ModernSecondaryLight">#E5D4F0</Color>

    <!-- Accent — mustard gold -->
    <Color x:Key="ModernAccent">#C9A03A</Color>
    <Color x:Key="ModernAccentHover">#B08D2D</Color>
    <Color x:Key="ModernAccentLight">#F0E0A8</Color>

    <!-- WYGINS+ tile palette (used by TileCard styles) -->
    <Color x:Key="TileLavender">#D4B7E8</Color>
    <Color x:Key="TileMustard">#C9A03A</Color>
    <Color x:Key="TileOrange">#E96B3C</Color>
    <Color x:Key="TileBlue">#BFD9F2</Color>
    <Color x:Key="TileCream">#F4E5C9</Color>
    <Color x:Key="TileSage">#A8C5A1</Color>

    <!-- Semantic Colors -->
    <Color x:Key="ModernSuccess">#10B981</Color>
    <Color x:Key="ModernSuccessLight">#6EE7B7</Color>
    <Color x:Key="ModernWarning">#F59E0B</Color>
    <Color x:Key="ModernWarningLight">#FCD34D</Color>
    <Color x:Key="ModernError">#EF4444</Color>
    <Color x:Key="ModernErrorLight">#FCA5A5</Color>
    <Color x:Key="ModernInfo">#3B82F6</Color>
    <Color x:Key="ModernInfoLight">#93C5FD</Color>

    <!-- Neutral Palette - Sophisticated Grays -->
    <Color x:Key="ModernGray50">#F9FAFB</Color>
    <Color x:Key="ModernGray100">#F3F4F6</Color>
    <Color x:Key="ModernGray200">#E5E7EB</Color>
    <Color x:Key="ModernGray300">#D1D5DB</Color>
    <Color x:Key="ModernGray400">#9CA3AF</Color>
    <Color x:Key="ModernGray500">#6B7280</Color>
    <Color x:Key="ModernGray600">#4B5563</Color>
    <Color x:Key="ModernGray700">#374151</Color>
    <Color x:Key="ModernGray800">#1F2937</Color>
    <Color x:Key="ModernGray900">#111827</Color>

    <!-- Background Colors — warm cream WYGINS+ vibe -->
    <Color x:Key="ModernBgPrimary">#FFFFFF</Color>
    <Color x:Key="ModernBgSecondary">#FAEFD9</Color>
    <Color x:Key="ModernBgTertiary">#F4E5C9</Color>

    <!-- Dark Mode Colors -->
    <Color x:Key="ModernBgPrimaryDark">#0F172A</Color>
    <Color x:Key="ModernBgSecondaryDark">#1E293B</Color>
    <Color x:Key="ModernBgTertiaryDark">#334155</Color>

    <!-- Text Colors — warm dark brown instead of pure black, matches the cream theme -->
    <Color x:Key="ModernTextPrimary">#2C1810</Color>
    <Color x:Key="ModernTextSecondary">#6B5848</Color>
    <Color x:Key="ModernTextTertiary">#A89380</Color>
    <Color x:Key="ModernTextPrimaryDark">#F9FAFB</Color>
    <Color x:Key="ModernTextSecondaryDark">#D1D5DB</Color>

    <!-- Border & Separator -->
    <Color x:Key="ModernBorder">#E5E7EB</Color>
    <Color x:Key="ModernBorderDark">#334155</Color>
    <Color x:Key="ModernBorderHover">#D1D5DB</Color>

    <!-- Shadow Colors -->
    <Color x:Key="ModernShadowLight">#00000010</Color>
    <Color x:Key="ModernShadowMedium">#00000020</Color>
    <Color x:Key="ModernShadowStrong">#00000040</Color>

    <!-- ==================== SPACING SYSTEM ==================== -->

    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing20">20</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>
    <x:Double x:Key="Spacing40">40</x:Double>
    <x:Double x:Key="Spacing48">48</x:Double>
    <x:Double x:Key="Spacing64">64</x:Double>

    <!-- ==================== RADIUS SYSTEM ==================== -->

    <x:Double x:Key="RadiusSmall">6</x:Double>
    <x:Double x:Key="RadiusMedium">8</x:Double>
    <x:Double x:Key="RadiusLarge">12</x:Double>
    <x:Double x:Key="RadiusXLarge">16</x:Double>
    <x:Double x:Key="RadiusFull">999</x:Double>

    <!-- ==================== TYPOGRAPHY SCALE ==================== -->

    <x:Double x:Key="FontSize10">10</x:Double>
    <x:Double x:Key="FontSize12">12</x:Double>
    <x:Double x:Key="FontSize14">14</x:Double>
    <x:Double x:Key="FontSize16">16</x:Double>
    <x:Double x:Key="FontSize18">18</x:Double>
    <x:Double x:Key="FontSize20">20</x:Double>
    <x:Double x:Key="FontSize24">24</x:Double>
    <x:Double x:Key="FontSize28">28</x:Double>
    <x:Double x:Key="FontSize32">32</x:Double>
    <x:Double x:Key="FontSize36">36</x:Double>
    <x:Double x:Key="FontSize48">48</x:Double>

    <!-- ==================== MODERN GRADIENTS ==================== -->

    <LinearGradientBrush x:Key="ModernGradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A8A" Offset="0.0" />
        <GradientStop Color="#2563EB" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernGradientAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FACC15" Offset="0.0" />
        <GradientStop Color="#EAB308" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernGradientSuccess" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0.0" />
        <GradientStop Color="#059669" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernGradientWarning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0.0" />
        <GradientStop Color="#D97706" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernGradientError" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0.0" />
        <GradientStop Color="#DC2626" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModernBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ModernBgPrimary}" Offset="0.0" />
        <GradientStop Color="{StaticResource ModernBgSecondary}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ==================== PAGE STYLES ==================== -->

    <Style x:Key="ModernPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgSecondary}, Dark={StaticResource ModernBgPrimaryDark}}" />
    </Style>

    <!-- Page background: warm cream — anchors the WYGINS+ retro vibe across all pages. -->
    <Style x:Key="GlassPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAEFD9, Dark=#1F1812}" />
    </Style>

    <!-- ==================== CARD STYLES ==================== -->

    <!-- Card: white surface, subtle shadow only (no border for cleaner look) -->
    <Style x:Key="ModernCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Shadow">
            <Shadow Brush="Black"
                    Offset="0,1"
                    Radius="3"
                    Opacity="0.04" />
        </Setter>
    </Style>

    <!-- Glass card: near-white surface with hairline navy-tinted border + soft shadow.
         Subtle Mica/depth illusion without the consumer-app translucency. -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2FFFFFF, Dark=#CC1E293B}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#0F1E3A8A, Dark=#33FFFFFF}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Shadow">
            <Shadow Brush="#1E3A8A"
                    Offset="0,2"
                    Radius="12"
                    Opacity="0.06" />
        </Setter>
    </Style>

    <!-- Tinted glass: same look but accent left edge — used to highlight the primary card -->
    <Style x:Key="GlassCardTinted" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Stroke" Value="{StaticResource ModernPrimary}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Subtle neutral button — for low-priority actions over a glass page -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2FFFFFF, Dark=#CC1E293B}" />
        <Setter Property="TextColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="BorderColor" Value="#1A1E3A8A" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryLighter}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Elevated Card (more prominent) -->
    <Style x:Key="ModernCardElevated" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource ModernShadowStrong}, Dark=#000000B0}"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Small Card -->
    <Style x:Key="ModernCardSmall" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ModernBorder}, Dark={StaticResource ModernBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource ModernShadowLight}, Dark=#00000060}"
                    Offset="0,1"
                    Radius="4"
                    Opacity="0.06" />
        </Setter>
    </Style>

    <!-- Interactive Card (hover effect) -->
    <Style x:Key="ModernCardInteractive" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource ModernPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ==================== BUTTON STYLES ==================== -->

    <!-- Primary Button: solid navy, flat (no shadow / no scale) -->
    <Style x:Key="ModernButtonPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernGray300}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary Button: outline navy on white -->
    <Style x:Key="ModernButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryLighter}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Ghost Button -->
    <Style x:Key="ModernButtonGhost" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryLight}" />
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Success Button -->
    <Style x:Key="ModernButtonSuccess" TargetType="Button" BasedOn="{StaticResource ModernButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernSuccess}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ModernSuccess}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.20" />
        </Setter>
    </Style>

    <!-- Warning Button -->
    <Style x:Key="ModernButtonWarning" TargetType="Button" BasedOn="{StaticResource ModernButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernWarning}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ModernWarning}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.20" />
        </Setter>
    </Style>

    <!-- Error/Danger Button -->
    <Style x:Key="ModernButtonDanger" TargetType="Button" BasedOn="{StaticResource ModernButtonPrimary}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernError}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ModernError}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.20" />
        </Setter>
    </Style>

    <!-- Small Button -->
    <Style x:Key="ModernButtonSmall" TargetType="Button" BasedOn="{StaticResource ModernButtonPrimary}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Icon Button -->
    <Style x:Key="ModernButtonIcon" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgTertiary}, Dark={StaticResource ModernBgTertiaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernGray300}" />
                            <Setter Property="Scale" Value="1.05" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ==================== INPUT STYLES ==================== -->

    <!-- Modern Entry -->
    <Style x:Key="ModernEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ModernTextTertiary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Modern Picker -->
    <Style x:Key="ModernPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="TitleColor" Value="{StaticResource ModernTextTertiary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Modern Switch -->
    <Style x:Key="ModernSwitch" TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>

    <!-- Modern CheckBox -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource ModernPrimary}" />
    </Style>

    <!-- ==================== TYPOGRAPHY STYLES ==================== -->

    <!-- Display -->
    <Style x:Key="ModernDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <!-- Heading 1 -->
    <Style x:Key="ModernH1" TargetType="Label">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <!-- Heading 2 -->
    <Style x:Key="ModernH2" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <!-- Heading 3 -->
    <Style x:Key="ModernH3" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <!-- Heading 4 -->
    <Style x:Key="ModernH4" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <!-- Body Large -->
    <Style x:Key="ModernBodyLarge" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Body -->
    <Style x:Key="ModernBody" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Body Small -->
    <Style x:Key="ModernBodySmall" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextSecondary}, Dark={StaticResource ModernTextSecondaryDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Caption -->
    <Style x:Key="ModernCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextTertiary}, Dark={StaticResource ModernTextSecondaryDark}}" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <!-- Overline -->
    <Style x:Key="ModernOverline" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextTertiary}, Dark={StaticResource ModernTextSecondaryDark}}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!-- ==================== ICON & BADGE STYLES ==================== -->

    <!-- Icon Container -->
    <Style x:Key="ModernIconContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryLight}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Badge -->
    <Style x:Key="ModernBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Badge Success -->
    <Style x:Key="ModernBadgeSuccess" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernSuccess}" />
    </Style>

    <!-- Badge Warning -->
    <Style x:Key="ModernBadgeWarning" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernWarning}" />
    </Style>

    <!-- Badge Error -->
    <Style x:Key="ModernBadgeError" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernError}" />
    </Style>

    <!-- ==================== LIST & ITEM STYLES ==================== -->

    <!-- List Item -->
    <Style x:Key="ModernListItem" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ModernBorder}, Dark={StaticResource ModernBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Separator -->
    <Style x:Key="ModernSeparator" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource ModernBorder}, Dark={StaticResource ModernBorderDark}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- ==================== DAKACLOCK PATTERNS ==================== -->

    <!-- Page header: clean H1 + subtitle on page background, no card/gradient -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource ModernGray500}" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Section header: small icon + label inside a card -->
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ModernTextPrimary}, Dark={StaticResource ModernTextPrimaryDark}}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ModernGray500}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <!-- Subtle in-card divider -->
    <Style x:Key="CardDivider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource ModernGray100}, Dark={StaticResource ModernGray800}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- ==================== WYGINS+ TILE PATTERNS ==================== -->

    <!-- Decorative serif heading — matches the WYGINS+ "Employee Handbook" style.
         Times New Roman with italic adds the swashy retro flavor on systems
         without a custom font installed. -->
    <Style x:Key="ScriptHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="Times New Roman" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold,Italic" />
        <Setter Property="LineHeight" Value="1.0" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>

    <Style x:Key="ScriptHeadingLarge" TargetType="Label" BasedOn="{StaticResource ScriptHeading}">
        <Setter Property="FontSize" Value="44" />
    </Style>

    <Style x:Key="ScriptHeadingSmall" TargetType="Label" BasedOn="{StaticResource ScriptHeading}">
        <Setter Property="FontSize" Value="22" />
    </Style>

    <!-- Brand wordmark — DAKA+ logo style -->
    <Style x:Key="BrandWordmark" TargetType="Label">
        <Setter Property="FontFamily" Value="Times New Roman" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold,Italic" />
        <Setter Property="TextColor" Value="{StaticResource ModernTextPrimary}" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <!-- Tile card: large square button with bold serif title bottom-left + "+" button top-right -->
    <Style x:Key="TileCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Small "+" badge — sits in a tile's top-right corner -->
    <Style x:Key="TilePlusBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#E96B3C" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Margin" Value="12" />
    </Style>

    <!-- Accent button: yellow CTA — used sparingly (only for highest-priority single action) -->
    <Style x:Key="ModernButtonAccent" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernAccent}" />
        <Setter Property="TextColor" Value="{StaticResource ModernGray900}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernAccentHover}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Compact button: small text-style action for inline rows -->
    <Style x:Key="ModernButtonCompact" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimaryLighter}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Chip (selectable pill) -->
    <Style x:Key="ChipUnselected" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernGray100}, Dark={StaticResource ModernGray800}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource ModernBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style x:Key="ChipSelected" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ModernPrimary}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Stat card: small KPI tile -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ModernPrimaryLighter}, Dark={StaticResource ModernPrimaryDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

</ResourceDictionary>
