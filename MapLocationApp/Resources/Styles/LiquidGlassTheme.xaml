<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ==================== Liquid Glass 色彩系統 ==================== -->

    <!-- 背景層次 - 採用更現代的漸層背景 -->
    <Color x:Key="GlassBackground">#F8FAFC</Color>
    <Color x:Key="GlassBackgroundDark">#0D1117</Color>
    <Color x:Key="GlassSecondaryBackground">#FFFFFF</Color>
    <Color x:Key="GlassSecondaryBackgroundDark">#161B22</Color>
    <Color x:Key="GlassTertiaryBackground">#F1F5F9</Color>
    <Color x:Key="GlassTertiaryBackgroundDark">#21262D</Color>

    <!-- 精緻的玻璃效果顏色 -->
    <Color x:Key="GlassBlur">#FFFFFF95</Color>
    <Color x:Key="GlassBlurDark">#161B2295</Color>
    <Color x:Key="GlassHighlight">#FFFFFF60</Color>
    <Color x:Key="GlassHighlightDark">#FFFFFF15</Color>
    <Color x:Key="GlassShadow">#0F172A20</Color>
    <Color x:Key="GlassShadowDark">#00000050</Color>

    <!-- 優雅的品牌色彩系統 -->
    <Color x:Key="LiquidPrimary">#6366F1</Color>
    <Color x:Key="LiquidPrimaryDark">#818CF8</Color>
    <Color x:Key="LiquidSecondary">#8B5CF6</Color>
    <Color x:Key="LiquidTertiary">#EC4899</Color>
    <Color x:Key="LiquidSuccess">#10B981</Color>
    <Color x:Key="LiquidWarning">#F59E0B</Color>
    <Color x:Key="LiquidDanger">#EF4444</Color>

    <!-- 精緻的文字顏色層次 -->
    <Color x:Key="LiquidTextPrimary">#0F172A</Color>
    <Color x:Key="LiquidTextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="LiquidTextSecondary">#475569</Color>
    <Color x:Key="LiquidTextSecondaryDark">#CBD5E1</Color>
    <Color x:Key="LiquidTextTertiary">#64748B</Color>
    <Color x:Key="LiquidTextTertiaryDark">#94A3B8</Color>

    <!-- 優雅的分隔線和邊框 -->
    <Color x:Key="LiquidSeparator">#E2E8F0</Color>
    <Color x:Key="LiquidSeparatorDark">#334155</Color>

    <!-- 次要背景顏色 -->
    <Color x:Key="LiquidBackgroundSecondary">#F1F5F9</Color>
    <Color x:Key="LiquidBackgroundSecondaryDark">#1E293B</Color>

    <!-- ==================== Liquid Glass 筆刷系統 ==================== -->

    <!-- 精緻的毛玻璃漸層 - 純灰色毛玻璃效果 -->
    <LinearGradientBrush x:Key="GlassMorphismBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Light=#F8F9FAAA, Dark=#2C2C2EAA}" Offset="0"/>
        <GradientStop Color="{AppThemeBinding Light=#F1F5F990, Dark=#1C1C1E90}" Offset="0.5"/>
        <GradientStop Color="{AppThemeBinding Light=#E2E8F070, Dark=#16161870}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Ultra 清透純白玻璃 (去除任何色偏) -->
    <LinearGradientBrush x:Key="UltraClearGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFFE6" Offset="0.35"/>
        <GradientStop Color="#FFFFFFCC" Offset="0.70"/>
        <GradientStop Color="#FFFFFFB3" Offset="1"/>
    </LinearGradientBrush>

    <!-- 現代化主背景漸層 -->
    <LinearGradientBrush x:Key="LiquidBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{AppThemeBinding Light={StaticResource GlassBackground}, Dark={StaticResource GlassBackgroundDark}}" Offset="0"/>
        <GradientStop Color="{AppThemeBinding Light=#F1F5F9, Dark=#0D1117}" Offset="1"/>
    </LinearGradientBrush>

    <!-- 柔和光暈 Radial 漸層，用於背景裝飾 (iPhone Liquid Glass 風格) -->
    <RadialGradientBrush x:Key="AccentGlowPurple" Center="0.5,0.5" Radius="1.0">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#7C3AED00" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AccentGlowBlue" Center="0.5,0.5" Radius="1.0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#2563EB00" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AccentGlowPink" Center="0.5,0.5" Radius="1.0">
        <GradientStop Color="#DB2777" Offset="0"/>
        <GradientStop Color="#DB277700" Offset="1"/>
    </RadialGradientBrush>

    <!-- 優雅的按鈕漸層 -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource LiquidPrimary}" Offset="0"/>
        <GradientStop Color="#4F46E5" Offset="1"/>
    </LinearGradientBrush>

    <!-- 次要按鈕漸層 -->
    <LinearGradientBrush x:Key="SecondaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource LiquidSecondary}" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- 成功按鈕漸層 -->
    <LinearGradientBrush x:Key="SuccessButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource LiquidSuccess}" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== Liquid Glass 樣式系統 ==================== -->

    <!-- T152: Simplified glass card - reduced shadow complexity for cleaner look -->
    <Style x:Key="LiquidGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UltraClearGlassBrush}"/>
        <Setter Property="BackgroundColor" Value="#FFFFFFF2"/>
        <Setter Property="Opacity" Value="0.95"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Stroke" Value="#FFFFFF66"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="8,8"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light=#0F172A20, Dark=#00000060}"
                    Offset="0,8"
                    Radius="16"
                    Opacity="0.15"/>
        </Setter>
    </Style>

    <!-- 中性灰階卡片 (若仍有偏色可改用) -->
    <Style x:Key="LiquidGlassCardNeutral" TargetType="Border" BasedOn="{StaticResource LiquidGlassCard}">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="BackgroundColor" Value="#F5F7FACC"/>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <!-- T152: Simplified small card - minimal shadow -->
    <Style x:Key="LiquidGlassCardSmall" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="StrokeThickness" Value="0.5"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,2"
                    Radius="6"
                    Opacity="0.12"/>
        </Setter>
    </Style>

    <!-- T152: Simplified primary button - subtle shadow -->
    <Style x:Key="LiquidPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidPrimary}"
                    Offset="0,2"
                    Radius="6"
                    Opacity="0.15"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.02"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Liquid 次要按鈕 (玻璃效果) -->
    <Style x:Key="LiquidSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.1"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.02"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Liquid 功能按鈕 -->
    <Style x:Key="LiquidSuccessButton" TargetType="Button" BasedOn="{StaticResource LiquidPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource SuccessButtonBrush}"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidSuccess}"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.3"/>
        </Setter>
    </Style>

    <Style x:Key="LiquidDangerButton" TargetType="Button" BasedOn="{StaticResource LiquidPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource LiquidDanger}"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidDanger}"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.3"/>
        </Setter>
    </Style>

    <!-- Liquid 次要功能按鈕 -->
    <Style x:Key="LiquidSecondaryFunctionButton" TargetType="Button" BasedOn="{StaticResource LiquidPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidSecondary}"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.3"/>
        </Setter>
    </Style>

    <!-- Liquid 晶片按鈕 (Chip Button) -->
    <Style x:Key="LiquidChipButton" TargetType="Button">
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light=#0F172A20, Dark=#00000040}"
                    Offset="0,2"
                    Radius="6"
                    Opacity="0.25"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.05"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Liquid 警告按鈕 -->
    <Style x:Key="LiquidWarningButton" TargetType="Button" BasedOn="{StaticResource LiquidPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource LiquidWarning}"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidWarning}"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.3"/>
        </Setter>
    </Style>

    <!-- Liquid 搜尋框 -->
    <Style x:Key="LiquidSearchBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.15"/>
        </Setter>
    </Style>

    <!-- Liquid 列表項目 -->
    <Style x:Key="LiquidListItem" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="StrokeThickness" Value="0.5"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,1"
                    Radius="4"
                    Opacity="0.1"/>
        </Setter>
    </Style>

    <!-- Liquid 次要圖示按鈕 -->
    <Style x:Key="LiquidSecondaryIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,2"
                    Radius="6"
                    Opacity="0.1"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.05"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Liquid 浮動按鈕 -->
    <Style x:Key="LiquidFloatingButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassMorphismBrush}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource GlassHighlightDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadow}, Dark={StaticResource GlassShadowDark}}"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.2"/>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.05"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ==================== 文字樣式 ==================== -->

    <!-- 大標題 -->
    <Style x:Key="LiquidLargeTitle" TargetType="Label">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <!-- 標題 -->
    <Style x:Key="LiquidTitle1" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <!-- 副標題 -->
    <Style x:Key="LiquidTitle2" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <!-- 小標題 -->
    <Style x:Key="LiquidTitle3" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <!-- 正文 -->
    <Style x:Key="LiquidBodyText" TargetType="Label">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <!-- 次要文字 -->
    <Style x:Key="LiquidSecondaryText" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextSecondary}, Dark={StaticResource LiquidTextSecondaryDark}}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <!-- 說明文字 -->
    <Style x:Key="LiquidCaptionText" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextTertiary}, Dark={StaticResource LiquidTextTertiaryDark}}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <!-- ==================== 輸入控件樣式 ==================== -->

    <!-- Liquid 輸入框 -->
    <Style x:Key="LiquidEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassSecondaryBackground}, Dark={StaticResource GlassSecondaryBackgroundDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"/>
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LiquidTextTertiary}, Dark={StaticResource LiquidTextTertiaryDark}}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Visual" Value="Material"/>
    </Style>

    <!-- ==================== 頁面樣式 ==================== -->

    <!-- Liquid 頁面樣式 -->
    <Style x:Key="LiquidPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassBackground}, Dark={StaticResource GlassBackgroundDark}}"/>
        <Setter Property="Background" Value="{StaticResource LiquidBackgroundBrush}"/>
    </Style>

    <!-- ==================== 特殊效果樣式 ==================== -->

    <!-- T152: Simplified icon container - minimal shadow -->
    <Style x:Key="LiquidIconContainer" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light=#F8F9FACC, Dark=#2C2C2ECC}" Offset="0"/>
                    <GradientStop Color="{AppThemeBinding Light=#E2E8F0AA, Dark=#1C1C1EAA}" Offset="0.5"/>
                    <GradientStop Color="{AppThemeBinding Light=#CBD5E188, Dark=#16161888}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#FFFFFF60, Dark=#FFFFFF20}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="WidthRequest" Value="52"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light=#64748B20, Dark=#00000040}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.12"/>
        </Setter>
    </Style>

    <!-- 狀態指示器 -->
    <Style x:Key="LiquidStatusIndicator" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource LiquidSuccess}"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 6"/>
        <Setter Property="WidthRequest" Value="12"/>
        <Setter Property="HeightRequest" Value="12"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LiquidSuccess}"
                    Offset="0,1"
                    Radius="3"
                    Opacity="0.4"/>
        </Setter>
    </Style>

    <!-- 分隔線樣式 (避免與 Color 資源鍵衝突，改名為 LiquidSeparatorStyle) -->
    <Style x:Key="LiquidSeparatorStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LiquidSeparator}, Dark={StaticResource LiquidSeparatorDark}}"/>
        <Setter Property="HeightRequest" Value="0.5"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

</ResourceDictionary>