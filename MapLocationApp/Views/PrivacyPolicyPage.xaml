<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.PrivacyPolicyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [PrivacyTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="800" HorizontalOptions="Center">

            <!-- 標題區域 -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="🔒" FontSize="56"/>
                <Label Text="隱私政策" Style="{StaticResource ModernH1}" HorizontalOptions="Center"/>
                <Label Text="保護您的隱私是我們的承諾" Style="{StaticResource ModernBody}" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- 政策內容 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="24">

                    <!-- 資料收集 -->
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="📊" FontSize="24"/>
                            <Label Text="資料收集" Style="{StaticResource ModernH4}"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource ModernBody}">
                            <Label.Text>
我們僅收集提供服務所必需的資料：
• GPS位置資訊（用於打卡功能）
• 打卡時間和地點記錄
• 裝置識別資訊（用於同步）
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource ModernSeparator}"/>

                    <!-- 資料使用 -->
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🎯" FontSize="24"/>
                            <Label Text="資料使用" Style="{StaticResource ModernH4}"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource ModernBody}">
                            <Label.Text>
您的資料僅用於：
• 提供位置打卡服務
• 生成考勤報告
• 改善應用程式功能
• 確保服務安全性
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource ModernSeparator}"/>

                    <!-- 資料保護 -->
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🛡️" FontSize="24"/>
                            <Label Text="資料保護" Style="{StaticResource ModernH4}"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource ModernBody}">
                            <Label.Text>
我們採用多重保護措施：
• 本地加密存儲
• 安全傳輸協議
• 定期安全審查
• 最小權限原則
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource ModernSeparator}"/>

                    <!-- 使用者權利 -->
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="👤" FontSize="24"/>
                            <Label Text="您的權利" Style="{StaticResource ModernH4}"/>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource ModernBody}">
                            <Label.Text>
您擁有以下權利：
• 查看個人資料
• 修正不正確資料
• 刪除個人資料
• 匯出資料副本
• 撤回同意
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- 聯絡資訊 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📧" FontSize="24"/>
                        <Label Text="聯絡我們" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource ModernBody}">
                        <Label.Text>
如果您對隱私政策有任何疑問或需要行使您的權利，請聯絡我們：

📧 電子郵件: privacy@maplocation.com
📞 電話: +886-2-1234-5678
📍 地址:
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- 政策更新 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🔄" FontSize="24"/>
                        <Label Text="政策更新" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource ModernBody}">
                        <Label.Text>
本隱私政策可能會不定期更新。我們將在重大變更前通知您，並在應用程式中公布最新版本。
                        </Label.Text>
                    </Label>

                    <Border BackgroundColor="{StaticResource ModernInfoLight}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,8,0,0">
                        <Label Text="最後更新: 2025年8月17日"
                               Style="{StaticResource ModernBodySmall}"
                               TextColor="{StaticResource ModernInfo}"
                               FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 操作按鈕 -->
            <VerticalStackLayout Spacing="12">
                <Button Text="✅ 我已閱讀並同意"
                        Style="{StaticResource ModernButtonSuccess}"
                        Clicked="OnAcceptClicked"/>

                <Button Text="📄 匯出我的資料"
                        Style="{StaticResource ModernButtonSecondary}"
                        Clicked="OnExportDataClicked"/>

                <Button Text="🗑️ 刪除我的資料"
                        Style="{StaticResource ModernButtonWarning}"
                        Clicked="OnDeleteDataClicked"
                        Margin="0,0,0,20"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
