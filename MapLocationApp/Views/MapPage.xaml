<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.MapPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             Title="地圖導航"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Map Area -->
        <Grid Grid.Row="0">
            <!-- Map Control -->
            <mapsui:MapControl x:Name="MapControl"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />

            <!-- Floating Control Buttons -->
            <VerticalStackLayout HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="16,24,16,0"
                                 Spacing="8">
                <Button x:Name="LocationButton"
                        Text="📍"
                        Style="{StaticResource ModernButtonIcon}"
                        BackgroundColor="{StaticResource ModernPrimary}"
                        TextColor="White"
                        CornerRadius="12"
                        Shadow="{StaticResource ModernPrimary}"
                        Clicked="OnLocationButtonClicked" />

                <Button x:Name="ZoomInButton"
                        Text="+"
                        Style="{StaticResource ModernButtonIcon}"
                        Clicked="OnZoomInClicked" />

                <Button x:Name="ZoomOutButton"
                        Text="-"
                        Style="{StaticResource ModernButtonIcon}"
                        Clicked="OnZoomOutClicked" />
            </VerticalStackLayout>

            <!-- Attribution Badge -->
            <Border HorizontalOptions="End"
                    VerticalOptions="End"
                    Style="{StaticResource ModernCardSmall}"
                    Margin="16"
                    Opacity="0.95">
                <Label x:Name="AttributionLabel"
                       Text="© OpenStreetMap"
                       Style="{StaticResource ModernCaption}" />
            </Border>

            <!-- Status Indicator -->
            <Border HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Style="{StaticResource ModernCardSmall}"
                    Margin="16,24,0,0">
                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="{StaticResource ModernSuccess}"
                            StrokeShape="RoundRectangle 6"
                            WidthRequest="8"
                            HeightRequest="8"
                            VerticalOptions="Center"/>
                    <Label x:Name="StatusLabel"
                           Text="準備就緒"
                           Style="{StaticResource ModernBodySmall}"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Bottom Control Panel -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCardElevated}"
                Margin="16,0,16,24">
            <VerticalStackLayout Spacing="16">

                <!-- Location Information -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="當前位置"
                           Style="{StaticResource ModernBodySmall}"
                           FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="📍" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="LocationLabel"
                               Text="位置: 準備獲取..."
                               Style="{StaticResource ModernBodySmall}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="🎯" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="AccuracyLabel"
                               Text="精確度: 未知"
                               Style="{StaticResource ModernCaption}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Control Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Button Grid.Column="0" Grid.Row="0"
                            Text="定位"
                            Style="{StaticResource ModernButtonPrimary}"
                            HeightRequest="44"
                            Clicked="OnLocationButtonClicked" />

                    <Button Grid.Column="1" Grid.Row="0"
                            x:Name="GeofenceButton"
                            Text="圍欄"
                            Style="{StaticResource ModernButtonSecondary}"
                            HeightRequest="44"
                            Clicked="OnGeofenceButtonClicked" />

                    <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ModernBgTertiary}, Dark={StaticResource ModernBgTertiaryDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource ModernBorder}"
                            StrokeThickness="1"
                            Padding="12">
                        <Picker x:Name="TileProviderPicker"
                                Title="選擇地圖類型"
                                Style="{StaticResource ModernPicker}"
                                BackgroundColor="Transparent"
                                Margin="0"
                                HeightRequest="36"
                                SelectedIndexChanged="OnTileProviderChanged" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>