<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.CheckInPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [CheckInTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,24" Spacing="16" MaximumWidthRequest="800" HorizontalOptions="Center">

            <!-- 用戶資訊區域 -->
            <Border Style="{StaticResource GlassCard}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <!-- 用戶頭像 -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            BackgroundColor="{StaticResource ModernPrimaryLight}"
                            StrokeShape="RoundRectangle 28"
                            WidthRequest="56"
                            HeightRequest="56"
                            Padding="0"
                            VerticalOptions="Center">
                        <Label Text="👤"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- 用戶資訊 -->
                    <Label Grid.Row="0" Grid.Column="1"
                           x:Name="UserNameLabel"
                           Text="{Binding [NotLoggedIn], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource ModernH4}"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           x:Name="UserDepartmentLabel"
                           Text="{Binding [PleaseLoginToUse], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource ModernBodySmall}"/>

                    <!-- 登出按鈕 -->
                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                            x:Name="LogoutButton"
                            Text="{Binding [Logout], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonSecondary}"
                            FontSize="14"
                            HeightRequest="40"
                            WidthRequest="80"
                            Padding="12,8"
                            VerticalOptions="Center"
                            Clicked="OnLogoutClicked"/>
                </Grid>
            </Border>

            <!-- 頁面標題 -->
            <Label Text="{Binding [SmartAttendance], Source={x:Static svc:LocalizationManager.Instance}}"
                   Style="{StaticResource ModernH2}"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0"/>

            <!-- 目前位置卡片 -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📍" FontSize="24"/>
                        <Label Text="{Binding [CurrentLocation], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="CurrentLocationLabel"
                               Text="{Binding [GettingLocation], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBody}"/>
                        <Label x:Name="AccuracyLabel"
                               Text=""
                               Style="{StaticResource ModernCaption}"/>
                    </VerticalStackLayout>

                    <!-- 位置地圖：MapsUi 的 SkiaSharp surface 在 Windows 上對 Grid.Clip 反應不好，
                         改用簡單 Border + StrokeShape，並透過 Margin 給卡片留邊避免視覺溢出。 -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource ModernGray200}, Dark={StaticResource ModernGray700}}"
                            StrokeThickness="1"
                            Padding="0"
                            HeightRequest="220">
                        <Grid x:Name="MapContainer"
                              BackgroundColor="{AppThemeBinding Light={StaticResource ModernGray100}, Dark={StaticResource ModernGray800}}">
                            <mapsui:MapControl x:Name="LocationMapControl"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill"/>
                            <Label x:Name="MapPlaceholderLabel"
                                   Text="{Binding [WaitingLocation], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="True"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 附近區域卡片 -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🎯" FontSize="24"/>
                        <Label Text="{Binding [NearbyAreas], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <CollectionView x:Name="NearbyGeofencesCollectionView"
                                    MaximumHeightRequest="240">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding [NoNearbyLocations], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalTextAlignment="Center"
                                   Padding="0,8"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernListItem}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource ModernBody}"
                                               FontAttributes="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Description}"
                                               Style="{StaticResource ModernBodySmall}"/>
                                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                Style="{StaticResource ModernBadge}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding DistanceText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 打卡操作卡片 -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="20">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⚡" FontSize="24"/>
                        <Label Text="{Binding [CheckInOperation], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="16" x:Name="CheckInOperationsPanel" IsEnabled="False">
                        <!-- 地理圍欄載入指示器 -->
                        <ActivityIndicator x:Name="GeofenceLoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="32"/>
                        <Label x:Name="GeofenceLoadingLabel"
                               Text="{Binding [LoadingCheckInLocations], Source={x:Static svc:LocalizationManager.Instance}}"
                               IsVisible="False"
                               Style="{StaticResource ModernBodySmall}"
                               TextColor="{StaticResource ModernTextSecondary}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding [SelectCheckInLocation], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBodySmall}"
                               TextColor="{StaticResource ModernTextSecondary}"
                               Margin="4,0,0,-8"/>
                        <Picker x:Name="GeofencePicker"
                                Title="{Binding [SelectCheckInLocation], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernPicker}"
                                HeightRequest="60"
                                MinimumHeightRequest="60"
                                FontSize="15"
                                VerticalTextAlignment="Center"
                                SelectedIndexChanged="OnGeofenceSelected" />

                        <Entry x:Name="NotesEntry"
                               Placeholder="{Binding [NotesPlaceholder], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernEntry}"
                               MaxLength="200" />

                        <!-- 打卡按鈕群組 -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    x:Name="CheckInButton"
                                    Text="{Binding [ClockInButton], Source={x:Static svc:LocalizationManager.Instance}}"
                                    Style="{StaticResource ModernButtonSuccess}"
                                    Clicked="OnCheckInClicked" />

                            <Button Grid.Column="1"
                                    x:Name="CheckOutButton"
                                    Text="{Binding [ClockOutButton], Source={x:Static svc:LocalizationManager.Instance}}"
                                    Style="{StaticResource ModernButtonWarning}"
                                    Clicked="OnCheckOutClicked"
                                    IsEnabled="False" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- 未登入提示 -->
                    <VerticalStackLayout x:Name="LoginRequiredPanel" IsVisible="True" Spacing="16">
                        <Border BackgroundColor="{StaticResource ModernWarningLight}"
                                StrokeShape="RoundRectangle 8"
                                Padding="16">
                            <Label Text="{Binding [LoginRequiredHint], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   TextColor="{StaticResource ModernWarning}"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold"/>
                        </Border>
                        <Button Text="{Binding [PleaseLoginFirst], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnGoToLoginClicked"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 今日記錄卡片 -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📋" FontSize="24"/>
                        <Label Text="{Binding [TodayRecordsTitle], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <CollectionView x:Name="TodayRecordsCollectionView"
                                    MaximumHeightRequest="320">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding [NoTodayRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalTextAlignment="Center"
                                   Padding="0,8"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernListItem}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <!-- 時間標記 -->
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                BackgroundColor="{StaticResource ModernSuccessLight}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="48"
                                                HeightRequest="48"
                                                Padding="0"
                                                VerticalOptions="Center">
                                            <Label Text="⏰"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource ModernSuccess}"/>
                                        </Border>

                                        <!-- 記錄內容 -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding GeofenceName}"
                                               Style="{StaticResource ModernBody}"
                                               FontAttributes="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Notes}"
                                               Style="{StaticResource ModernBodySmall}"/>

                                        <!-- 時間和持續時間 -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding CheckInTimeText}"
                                                   Style="{StaticResource ModernBody}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource ModernInfo}"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding DurationText}"
                                                   Style="{StaticResource ModernCaption}"
                                                   HorizontalTextAlignment="End"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 快速入口列表 -->
            <Border Style="{StaticResource GlassCard}" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="20,14" RowSpacing="0">
                        <Label Grid.Column="0" Text="{Binding [MyCheckInRecords], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageRecordsClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                        <Label Grid.Column="0" Text="{Binding [MyShift], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                        <Label Grid.Column="0" Text="{Binding [LeaveTitle], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLeaveClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                        <Label Grid.Column="0" Text="{Binding [ManageGeofences], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageGeofencesClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                        <Label Grid.Column="0" Text="{Binding [ProfileEntry], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="RefreshButton"
                    Text="{Binding [RefreshLabel], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonSecondary}"
                    Clicked="OnRefreshClicked"/>

            <Button Text="{Binding [MyReport], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonPrimary}"
                    Clicked="OnReportClicked"
                    Margin="0,0,0,16"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
