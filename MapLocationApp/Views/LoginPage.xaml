<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [Login], Source={x:Static svc:LocalizationManager.Instance}}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource ModernBgSecondary}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light=#F9FAFB, Dark=#0F172A}" Offset="0.5" />
                    <GradientStop Color="{AppThemeBinding Light=#F3F4F6, Dark=#1E293B}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <Grid RowDefinitions="*,Auto,*"
                  Padding="{OnPlatform Android='24,48,24,32', iOS='24,60,24,32', Default='32,60,32,40'}"
                  MaximumWidthRequest="480"
                  HorizontalOptions="Center">

                <!-- Logo and Header Section -->
                <VerticalStackLayout Grid.Row="0"
                                     VerticalOptions="End"
                                     Spacing="24">

                    <!-- Logo Icon -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ModernBgPrimary}, Dark={StaticResource ModernBgSecondaryDark}}"
                           StrokeShape="RoundRectangle 24"
                           Stroke="{StaticResource ModernPrimaryLight}"
                           StrokeThickness="2"
                           WidthRequest="96"
                           HeightRequest="96"
                           HorizontalOptions="Center"
                           Padding="0">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource ModernPrimary}"
                                    Offset="0,4"
                                    Radius="16"
                                    Opacity="0.15" />
                        </Border.Shadow>
                        <Label Text="📍"
                               FontSize="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Title -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="MapLocation"
                               Style="{StaticResource ModernH1}"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding [SmartLocationSystem], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBodySmall}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Login Form Card -->
                <Border Grid.Row="1"
                       Style="{StaticResource ModernCardElevated}"
                       Margin="0,32,0,0">

                    <VerticalStackLayout Spacing="24">

                        <!-- Welcome Text -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding [WelcomeBack], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernH3}"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding [PleaseLoginToContinue], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- Input Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Username Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding [Username], Source={x:Static svc:LocalizationManager.Instance}}"
                                       Style="{StaticResource ModernBodySmall}"
                                       FontAttributes="Bold"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ModernBgTertiary}, Dark={StaticResource ModernBgTertiaryDark}}"
                                       StrokeShape="RoundRectangle 8"
                                       Stroke="{StaticResource ModernBorder}"
                                       StrokeThickness="1"
                                       Padding="16,0">
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="👤"
                                               FontSize="18"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource ModernTextTertiary}"/>
                                        <Entry x:Name="UsernameEntry"
                                               Placeholder="{Binding [UsernamePlaceholder], Source={x:Static svc:LocalizationManager.Instance}}"
                                               Style="{StaticResource ModernEntry}"
                                               BackgroundColor="Transparent"
                                               Margin="0"
                                               HorizontalOptions="FillAndExpand"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding [Password], Source={x:Static svc:LocalizationManager.Instance}}"
                                       Style="{StaticResource ModernBodySmall}"
                                       FontAttributes="Bold"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ModernBgTertiary}, Dark={StaticResource ModernBgTertiaryDark}}"
                                       StrokeShape="RoundRectangle 8"
                                       Stroke="{StaticResource ModernBorder}"
                                       StrokeThickness="1"
                                       Padding="16,0">
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="🔒"
                                               FontSize="18"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource ModernTextTertiary}"/>
                                        <Entry x:Name="PasswordEntry"
                                               Placeholder="{Binding [PasswordPlaceholder], Source={x:Static svc:LocalizationManager.Instance}}"
                                               IsPassword="True"
                                               Style="{StaticResource ModernEntry}"
                                               BackgroundColor="Transparent"
                                               Margin="0"
                                               HorizontalOptions="FillAndExpand"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Remember Me & Forgot Password -->
                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                    <CheckBox x:Name="RememberMeCheckbox"
                                             Style="{StaticResource ModernCheckBox}"
                                             VerticalOptions="Center"/>
                                    <Label Text="{Binding [RememberMe], Source={x:Static svc:LocalizationManager.Instance}}"
                                           Style="{StaticResource ModernBodySmall}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding [ForgotPassword], Source={x:Static svc:LocalizationManager.Instance}}"
                                       Style="{StaticResource ModernBodySmall}"
                                       TextColor="{StaticResource ModernPrimary}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                        </VerticalStackLayout>

                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Text="{Binding [Login], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnLoginClicked"/>

                        <!-- Biometric quick login (only shown when a user is bound to this device) -->
                        <Button x:Name="BiometricLoginButton"
                                Text=""
                                IsVisible="False"
                                Style="{StaticResource ModernButtonSecondary}"
                                Clicked="OnBiometricLoginClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Section -->
                <VerticalStackLayout Grid.Row="2"
                                     VerticalOptions="End"
                                     Spacing="16">

                    <!-- Register Link -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                          Spacing="6">
                        <Label Text="{Binding [NoAccount], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBodySmall}"/>
                        <Label Text="{Binding [RegisterNow], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBodySmall}"
                               TextColor="{StaticResource ModernPrimary}"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Version Info -->
                    <Label Text="{Binding [AppVersion], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource ModernCaption}"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
