<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.SchedulePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [ScheduleTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="0" Padding="4,16,4,8">
                <Label Text="{Binding [MyShift], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitle}"/>
                <Label Text="{Binding [ScheduleTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageSubtitle}"/>
            </VerticalStackLayout>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="10">
                    <Button Text="{Binding [ApplyDefaultHours], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonCompact}"
                            HorizontalOptions="Start"
                            Clicked="OnApplyDefaultClicked"/>

                    <CollectionView x:Name="DaysCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ModernGray50}, Dark={StaticResource ModernBgTertiaryDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource ModernBorder}"
                                        StrokeThickness="1"
                                        Padding="14,10"
                                        Margin="0,3">
                                    <Grid ColumnDefinitions="60,Auto,*,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding DayLabel}"
                                               Style="{StaticResource ModernBody}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsRestDay, Mode=TwoWay}"
                                                  CheckedChanged="OnRestDayToggled"
                                                  VerticalOptions="Center"/>
                                        <TimePicker Grid.Column="2"
                                                    Time="{Binding Start, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsWorkDay}"
                                                    Format="HH:mm"/>
                                        <TimePicker Grid.Column="3"
                                                    Time="{Binding End, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsWorkDay}"
                                                    Format="HH:mm"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding [Save], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonPrimary}"
                    Clicked="OnSaveClicked"
                    Margin="0,8,0,16"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
