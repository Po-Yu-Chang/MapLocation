<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.RoutePlanningPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             Title="智慧導航"
             Style="{StaticResource LiquidPageStyle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/LiquidGlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- 根據導航狀態動態切換的主要布局 -->
    <Grid>
        
        <!-- 路線規劃模式 (非導航時顯示) -->
        <Grid x:Name="RoutePlanningMode" 
              IsVisible="{Binding IsNotNavigating}"
              RowDefinitions="Auto,*">
            
            <!-- 液態玻璃搜尋控制區域 -->
            <Border Grid.Row="0" Style="{StaticResource LiquidGlassCard}" Margin="16,20,16,8" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{AppThemeBinding Light=#FFFFFF95, Dark=#1C1C1E95}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#F8F9FADD, Dark=#2C2C2EDD}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

            <VerticalStackLayout Spacing="16">
                <!-- 起點搜尋框 -->
                <Border Style="{StaticResource LiquidSearchBox}">
                    <Grid ColumnDefinitions="44,*,48,48" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource LiquidIconContainer}"
                                BackgroundColor="{StaticResource LiquidSuccess}"
                                WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0">
                            <Label Text="📍" FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="White"/>
                        </Border>
                        <Entry Grid.Column="1"
                               x:Name="StartLocationEntry"
                               Placeholder="您的位置或輸入起點"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="{StaticResource LiquidTextSecondary}"
                               Margin="0,12"
                               TextChanged="OnStartLocationTextChanged"/>
                        <Button Grid.Column="2"
                                x:Name="UseCurrentLocationButton"
                                Style="{StaticResource LiquidSecondaryIconButton}"
                                Text="🎯"
                                WidthRequest="44" HeightRequest="44"
                                Clicked="OnUseCurrentLocationClicked"/>
                        <Button Grid.Column="3"
                                x:Name="SwapLocationsButton"
                                Style="{StaticResource LiquidSecondaryIconButton}"
                                Text="🔄"
                                WidthRequest="44" HeightRequest="44"
                                Clicked="OnSwapLocationsClicked"/>
                    </Grid>
                </Border>

                <!-- 起點搜尋建議 - 液態玻璃風格 -->
                <Border x:Name="StartSuggestionsContainer" IsVisible="False"
                        Style="{StaticResource LiquidGlassCard}" Margin="0,4,0,0" Padding="8">
                    <CollectionView x:Name="StartSuggestionsView"
                                    ItemsSource="{Binding FromSuggestions}"
                                    BackgroundColor="Transparent"
                                    MaximumHeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LiquidListItem}" Margin="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStartSuggestionTapped"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12" Padding="12">
                                        <Border Grid.Column="0" Style="{StaticResource LiquidIconContainer}"
                                                BackgroundColor="{StaticResource LiquidPrimary}"
                                                WidthRequest="28" HeightRequest="28">
                                            <Label Text="📍" FontSize="14" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding MainText}"
                                                   Style="{StaticResource LiquidBodyText}"/>
                                            <Label Text="{Binding SecondaryText}"
                                                   Style="{StaticResource LiquidCaptionText}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                
                <!-- 液態玻璃連接線 -->
                <StackLayout HorizontalOptions="Start" Margin="38,8,0,8">
                    <Border WidthRequest="3" HeightRequest="4"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 1.5"
                            Opacity="0.8" HorizontalOptions="Center"/>
                    <Border WidthRequest="3" HeightRequest="4"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 1.5"
                            Opacity="0.6" HorizontalOptions="Center" Margin="0,2"/>
                    <Border WidthRequest="3" HeightRequest="4"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 1.5"
                            Opacity="0.4" HorizontalOptions="Center"/>
                </StackLayout>
                
                <!-- 終點搜尋框 -->
                <Border Style="{StaticResource LiquidSearchBox}">
                    <Grid ColumnDefinitions="44,*,48" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource LiquidIconContainer}"
                                BackgroundColor="{StaticResource LiquidTertiary}"
                                WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0">
                            <Label Text="🏁" FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="White"/>
                        </Border>
                        <Entry Grid.Column="1"
                               x:Name="EndLocationEntry"
                               Placeholder="輸入目的地"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="{StaticResource LiquidTextSecondary}"
                               Margin="0,12"
                               TextChanged="OnEndLocationTextChanged"/>
                        <Button Grid.Column="2"
                                x:Name="ClearEndLocationButton"
                                Style="{StaticResource LiquidSecondaryIconButton}"
                                Text="✕"
                                WidthRequest="44" HeightRequest="44"
                                Clicked="OnClearEndLocationClicked"/>
                    </Grid>
                </Border>

                <!-- 終點搜尋建議 - 液態玻璃風格 -->
                <Border x:Name="EndSuggestionsContainer" IsVisible="False"
                        Style="{StaticResource LiquidGlassCard}" Margin="0,4,0,0" Padding="8">
                    <CollectionView x:Name="EndSuggestionsView"
                                    ItemsSource="{Binding ToSuggestions}"
                                    BackgroundColor="Transparent"
                                    MaximumHeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LiquidListItem}" Margin="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEndSuggestionTapped"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12" Padding="12">
                                        <Border Grid.Column="0" Style="{StaticResource LiquidIconContainer}"
                                                BackgroundColor="{StaticResource LiquidTertiary}"
                                                WidthRequest="28" HeightRequest="28">
                                            <Label Text="📍" FontSize="14" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding MainText}"
                                                   Style="{StaticResource LiquidBodyText}"/>
                                            <Label Text="{Binding SecondaryText}"
                                                   Style="{StaticResource LiquidCaptionText}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                
                <!-- 路線選項按鈕 - 液態玻璃風格 -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12">
                    <Button x:Name="FastestRouteButton" Grid.Column="0"
                            Text="🚗 最快"
                            Style="{StaticResource LiquidChipButton}"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            TextColor="White"
                            HeightRequest="40" FontSize="13"
                            Clicked="OnRouteOptionClicked"/>
                    <Button x:Name="ShortestRouteButton" Grid.Column="1"
                            Text="📏 最短"
                            Style="{StaticResource LiquidChipButton}"
                            BackgroundColor="{StaticResource LiquidSecondary}"
                            TextColor="White"
                            HeightRequest="40" FontSize="13"
                            Clicked="OnRouteOptionClicked"/>
                    <Button x:Name="EcoRouteButton" Grid.Column="2"
                            Text="🌱 節能"
                            Style="{StaticResource LiquidChipButton}"
                            BackgroundColor="{StaticResource LiquidSuccess}"
                            TextColor="White"
                            HeightRequest="40" FontSize="13"
                            Clicked="OnRouteOptionClicked"/>
                </Grid>
                
                <!-- 規劃路線按鈕 -->
                <Button x:Name="GetDirectionsButton"
                        Text="開始導航"
                        Style="{StaticResource LiquidPrimaryButton}"
                        HeightRequest="52"
                        Margin="0,16,0,8"
                        Clicked="OnGetDirectionsClicked">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.3" Radius="12" Offset="0,4" />
                    </Button.Shadow>
                </Button>

                <!-- 測試導航按鈕 (暫時) -->
                <Button x:Name="TestNavigationButton"
                        Text="🧪 測試模式"
                        Style="{StaticResource LiquidSecondaryButton}"
                        HeightRequest="44"
                        Margin="0,4,0,8"
                        Clicked="OnTestNavigationClicked"/>
            </VerticalStackLayout>
            </Border>
            
            <!-- 路線規劃模式的地圖 -->
            <Grid Grid.Row="1">
                <mapsui:MapControl x:Name="PlanningMapView" />
                
        
<!-- 路線結果卡片 - 液態玻璃風格 -->
<CollectionView x:Name="RouteOptionsCollectionView"
                ItemsSource="{Binding RouteOptions}"
                BackgroundColor="Transparent"
                Margin="16"
                VerticalOptions="End"
                IsVisible="False">
    <CollectionView.ItemTemplate>
        <DataTemplate>
            <Border Style="{StaticResource LiquidGlassCard}"
                    Padding="20" Margin="0,6">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsSelected}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{StaticResource LiquidPrimary}" />
                        <Setter Property="StrokeThickness" Value="2" />
                        <Setter Property="Shadow">
                            <Setter.Value>
                                <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.4" Radius="16" Offset="0,4" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRouteOptionSelected" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="16">
                    <Border Grid.RowSpan="3" Grid.Column="0"
                            Style="{StaticResource LiquidIconContainer}"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            WidthRequest="56" HeightRequest="56"
                            VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="🚗" FontSize="28"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="White" />
                    </Border>
                    <StackLayout Grid.Row="0" Grid.Column="1"
                                 Orientation="Horizontal" Spacing="10">
                        <Label Text="{Binding Duration}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}" />
                        <Label Text="{Binding Distance}"
                               FontSize="16"
                               TextColor="{StaticResource LiquidPrimary}"
                               VerticalOptions="End" />
                    </StackLayout>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding Description}"
                           Style="{StaticResource LiquidBodyText}"
                           LineBreakMode="TailTruncation" />
                    <StackLayout Grid.Row="2" Grid.Column="1"
                                 Orientation="Horizontal" Spacing="8">
                        <Border WidthRequest="12" HeightRequest="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{Binding TrafficColor}"
                                VerticalOptions="Center" />
                        <Label Text="{Binding TrafficInfo}"
                               Style="{StaticResource LiquidCaptionText}" />
                    </StackLayout>
                    <StackLayout Grid.RowSpan="3" Grid.Column="2"
                                 VerticalOptions="Center" HorizontalOptions="End"
                                 Spacing="8">
                        <Label Text="選擇"
                               FontSize="12"
                               TextColor="{StaticResource LiquidPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="›"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="{StaticResource LiquidPrimary}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>

<Border x:Name="RoutePreviewCard"
        Margin="16,0,16,24" Padding="24"
        VerticalOptions="End" HorizontalOptions="FillAndExpand"
        Style="{StaticResource LiquidGlassCard}"
        IsVisible="True">
    <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{AppThemeBinding Light=#FFFFFF88, Dark=#1C1C1E88}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light=#F8F9FACC, Dark=#2C2C2ECC}" Offset="1.0" />
        </LinearGradientBrush>
    </Border.Background>
    <Border.Shadow>
        <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.25" Radius="20" Offset="0,8" />
    </Border.Shadow>
    <Border.Triggers>
        <DataTrigger TargetType="Border"
                     Binding="{Binding CurrentRoute}"
                     Value="{x:Null}">
            <Setter Property="IsVisible" Value="False" />
        </DataTrigger>
        <DataTrigger TargetType="Border"
                     Binding="{Binding IsNavigating}"
                     Value="True">
            <Setter Property="IsVisible" Value="False" />
        </DataTrigger>
    </Border.Triggers>
    <Grid ColumnDefinitions="*,Auto"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="20"
          RowSpacing="18">
        <StackLayout Grid.Row="0"
                     Grid.Column="0"
                     Spacing="6">
            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="{Binding CurrentRoute.FormattedDuration}"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}" />
                <Label Text="{Binding CurrentRoute.FormattedDistance}"
                       FontSize="18"
                       TextColor="{StaticResource LiquidPrimary}"
                       VerticalOptions="End" />
            </StackLayout>
            <Label Text="{Binding CurrentRoute.DisplayEndAddress}"
                   Style="{StaticResource LiquidBodyText}"
                   LineBreakMode="TailTruncation" />
            <Label Text="{Binding SelectedTransportMode, StringFormat='智慧導航 · {0}'}"
                   Style="{StaticResource LiquidCaptionText}" />
        </StackLayout>
        <Button Grid.Column="1" Grid.RowSpan="2"
                Text="開始導航"
                Style="{StaticResource LiquidPrimaryButton}"
                WidthRequest="140" HeightRequest="68"
                FontSize="18" FontAttributes="Bold"
                Clicked="OnStartNavigationClicked">
            <Button.Shadow>
                <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.4" Radius="16" Offset="0,6" />
            </Button.Shadow>
        </Button>
        <Grid Grid.Row="1"
              Grid.Column="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
            <StackLayout Grid.Column="0"
                         Spacing="10"
                         VerticalOptions="Center">
                <Border WidthRequest="12" HeightRequest="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{StaticResource LiquidSuccess}" />
                <Border WidthRequest="3" HeightRequest="24"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 1.5"
                        BackgroundColor="{StaticResource LiquidTextSecondary}"
                        HorizontalOptions="Center" />
                <Border WidthRequest="12" HeightRequest="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{StaticResource LiquidTertiary}" />
            </StackLayout>
            <StackLayout Grid.Column="1"
                         Spacing="8">
                <StackLayout Spacing="2">
                    <Label Text="起點"
                           Style="{StaticResource LiquidCaptionText}" />
                    <Label Text="{Binding CurrentRoute.DisplayStartAddress}"
                           Style="{StaticResource LiquidBodyText}"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
                <StackLayout Spacing="2">
                    <Label Text="終點"
                           Style="{StaticResource LiquidCaptionText}" />
                    <Label Text="{Binding CurrentRoute.DisplayEndAddress}"
                           Style="{StaticResource LiquidBodyText}"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
            </StackLayout>
        </Grid>
    </Grid>
</Border>
            </Grid>
        </Grid>
        

<!-- Google Maps 風格全螢幕導航模式 (導航時顯示) -->
<Grid x:Name="NavigationMode"
      IsVisible="{Binding IsNavigating}">
    <mapsui:MapControl x:Name="NavigationMapView" />

    <Grid Margin="0"
          RowSpacing="0"
          ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="16,40,16,0" Padding="24,20"
                Style="{StaticResource LiquidGlassCard}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF90, Dark=#1C1C1E90}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light=#F8F9FADD, Dark=#2C2C2EDD}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.3" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="18">
                    <Border Style="{StaticResource LiquidIconContainer}"
                            BackgroundColor="{StaticResource LiquidPrimary}"
                            WidthRequest="80" HeightRequest="80"
                            VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentInstruction.ArrowIcon}"
                               FontSize="40"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="White" />
                    </Border>
                    <StackLayout Grid.Column="1"
                                 Spacing="6"
                                 VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="{Binding CurrentInstruction.Distance}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource LiquidPrimary}" />
                            <Label Text="{Binding RemainingTime}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}" />
                        </StackLayout>
                        <Label Text="{Binding CurrentInstruction.Text}"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LiquidTextPrimary}, Dark={StaticResource LiquidTextPrimaryDark}}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding CurrentInstruction.StreetName}"
                               Style="{StaticResource LiquidBodyText}"
                               LineBreakMode="TailTruncation" />
                    </StackLayout>
                    <StackLayout Grid.Column="2"
                                 Spacing="12"
                                 VerticalOptions="Center">
                        <Button x:Name="NavigationMuteButton"
                                Style="{StaticResource LiquidSecondaryIconButton}"
                                Text="🔊"
                                WidthRequest="52" HeightRequest="52"
                                Clicked="OnMuteToggleClicked" />
                        <Button x:Name="NavigationMenuButton"
                                Style="{StaticResource LiquidSecondaryIconButton}"
                                Text="⋮"
                                WidthRequest="52" HeightRequest="52"
                                Clicked="OnNavigationMenuClicked" />
                    </StackLayout>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Margin="0,24,0,0"
                             Progress="{Binding RouteProgress}"
                             ProgressColor="{StaticResource LiquidPrimary}"
                             BackgroundColor="{StaticResource LiquidBackgroundSecondary}"
                             HeightRequest="6" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1"
                             Margin="0,0,16,160"
                             Spacing="12"
                             VerticalOptions="End"
                             HorizontalOptions="End">
            <Button x:Name="RecenterButton"
                    Style="{StaticResource LiquidFloatingButton}"
                    Text="🎯"
                    WidthRequest="60" HeightRequest="60"
                    FontSize="28"
                    Clicked="OnRecenterClicked" />
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="ZoomInButton" Grid.Row="0"
                        Style="{StaticResource LiquidFloatingButton}"
                        Text="+"
                        WidthRequest="60" HeightRequest="52"
                        FontSize="28" FontAttributes="Bold"
                        Clicked="OnZoomInClicked" />
                <Button x:Name="ZoomOutButton" Grid.Row="1"
                        Style="{StaticResource LiquidFloatingButton}"
                        Text="−"
                        WidthRequest="60" HeightRequest="52"
                        FontSize="28" FontAttributes="Bold"
                        Clicked="OnZoomOutClicked" />
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="2"
                Margin="16,0,16,32" Padding="24,20"
                Style="{StaticResource LiquidGlassCard}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF90}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light=#F8F9FA, Dark=#F8F9FADD}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{StaticResource LiquidPrimary}" Opacity="0.2" Radius="16" Offset="0,8" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="20"
                  VerticalOptions="Center">
                <StackLayout Grid.Column="0"
                             Spacing="6">
                    <StackLayout Orientation="Horizontal"
                                 Spacing="8">
                        <Label Text="{Binding RemainingTime}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="{StaticResource LiquidTextPrimary}" />
                        <Label Text="{Binding RemainingDistance}"
                               FontSize="20"
                               TextColor="{StaticResource LiquidPrimary}"
                               VerticalOptions="Center" />
                    </StackLayout>
                    <Label FontSize="14"
                           TextColor="#6B7280">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="抵達 " />
                                <Span Text="{Binding EstimatedArrivalTime}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </StackLayout>
                <Button Grid.Column="1"
                        Text="結束"
                        Style="{StaticResource LiquidWarningButton}"
                        WidthRequest="130" HeightRequest="60"
                        FontSize="18" FontAttributes="Bold"
                        Clicked="OnStopNavigationClicked" />
            </Grid>
        </Border>
    </Grid>

    <Button x:Name="ExitNavigationButton"
            Style="{StaticResource LiquidFloatingButton}"
            Text="←"
            WidthRequest="50" HeightRequest="50"
            FontSize="24" FontAttributes="Bold"
            Margin="16,40,0,0"
            VerticalOptions="Start" HorizontalOptions="Start"
            Clicked="OnExitNavigationClicked" />

    <Grid x:Name="EndNavigationOverlay"
          IsVisible="{Binding IsEndNavigationSheetVisible}">
        <BoxView Color="#88000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnEndOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Style="{StaticResource LiquidGlassCard}"
                Margin="16,0,16,40" Padding="28,24"
                VerticalOptions="End">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF90}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light=#F8F9FA, Dark=#F8F9FADD}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{StaticResource LiquidWarning}" Opacity="0.3" Radius="16" Offset="0,8" />
            </Border.Shadow>
            <StackLayout Spacing="16">
                <Label Text="結束導航？"
                       Style="{StaticResource LiquidTitle2}" />
                <Label Style="{StaticResource LiquidBodyText}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding RemainingTime}" />
                            <Span Text=" · " />
                            <Span Text="{Binding RemainingDistance}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <StackLayout Spacing="4">
                    <Label Text="{Binding CurrentRoute.DisplayStartAddress}"
                           Style="{StaticResource LiquidCaptionText}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding CurrentRoute.DisplayEndAddress}"
                           Style="{StaticResource LiquidCaptionText}"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button Text="取消" Grid.Column="0"
                            Style="{StaticResource LiquidSecondaryButton}"
                            HeightRequest="56"
                            Clicked="OnCancelStopNavigationClicked" />
                    <Button Text="結束導航" Grid.Column="1"
                            Style="{StaticResource LiquidWarningButton}"
                            HeightRequest="56"
                            Clicked="OnConfirmStopNavigationClicked" />
                </Grid>
            </StackLayout>
        </Border>
    </Grid>
</Grid>

    </Grid>
</ContentPage>