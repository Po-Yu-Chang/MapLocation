<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.LeavePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [LeaveTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="0" Padding="4,16,4,8">
                <Label Text="{Binding [MyLeaves], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitle}"/>
                <Label Text="{Binding [LeaveTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageSubtitle}"/>
            </VerticalStackLayout>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="FormTitleLabel"
                           Text="{Binding [AddBtn], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>

                    <Label Text="{Binding [LeaveType], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Picker x:Name="TypePicker" Style="{StaticResource ModernPicker}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding [StartDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="StartDatePicker" Format="yyyy-MM-dd"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding [EndDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="EndDatePicker" Format="yyyy-MM-dd"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding [Notes], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Editor x:Name="NoteEditor" HeightRequest="60" MaxLength="500"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                x:Name="SaveButton"
                                Text="{Binding [AddBtn], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnSaveClicked"/>
                        <Button Grid.Column="1"
                                x:Name="CancelEditButton"
                                Text="{Binding [CancelEdit], Source={x:Static svc:LocalizationManager.Instance}}"
                                IsVisible="False"
                                Style="{StaticResource ModernButtonSecondary}"
                                Clicked="OnCancelClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding [MyLeaves], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource SectionTitle}"/>

                    <CollectionView x:Name="LeavesCollectionView">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding [NoLeaveRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,16"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource ModernBorder}"
                                        StrokeThickness="1"
                                        Padding="0"
                                        Margin="0,3">
                                    <Grid ColumnDefinitions="4,*,Auto">
                                        <BoxView Grid.Column="0" Color="#FACC15"/>
                                        <VerticalStackLayout Grid.Column="1" Padding="14,10" Spacing="2">
                                            <Label Text="{Binding HeaderText}" Style="{StaticResource ModernBody}" FontAttributes="Bold"/>
                                            <Label Text="{Binding DetailText}" Style="{StaticResource ModernBodySmall}" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" Padding="0,0,10,0">
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Edit]}"
                                                    Style="{StaticResource ModernButtonCompact}"
                                                    Clicked="OnEditClicked" CommandParameter="{Binding Id}"/>
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Delete]}"
                                                    BackgroundColor="{StaticResource ModernErrorLight}"
                                                    TextColor="{StaticResource ModernError}"
                                                    CornerRadius="6"
                                                    Padding="12,6"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    HeightRequest="34"
                                                    Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding [Refresh], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonCompact}"
                            HorizontalOptions="Start"
                            Clicked="OnRefreshClicked"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
