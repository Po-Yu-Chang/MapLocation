<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.LeavePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [LeaveTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding [Back], Source={x:Static svc:LocalizationManager.Instance}}" Clicked="OnBackClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="800" HorizontalOptions="Center">
            <Button Text="{Binding [Back], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonSecondary}"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked"/>

            <Label Text="{Binding [MyLeaves], Source={x:Static svc:LocalizationManager.Instance}}"
                   Style="{StaticResource ModernH2}"
                   HorizontalOptions="Center"/>

            <!-- 表單 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="FormTitleLabel"
                           Text="{Binding [AddBtn], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource ModernH4}"/>

                    <Label Text="{Binding [LeaveType], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Picker x:Name="TypePicker"/>

                    <Label Text="{Binding [StartDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <DatePicker x:Name="StartDatePicker" Format="yyyy-MM-dd"/>

                    <Label Text="{Binding [EndDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <DatePicker x:Name="EndDatePicker" Format="yyyy-MM-dd"/>

                    <Label Text="{Binding [Notes], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Editor x:Name="NoteEditor" HeightRequest="60" MaxLength="500"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                x:Name="SaveButton"
                                Text="{Binding [AddBtn], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnSaveClicked"/>
                        <Button Grid.Column="1"
                                x:Name="CancelEditButton"
                                Text="{Binding [CancelEdit], Source={x:Static svc:LocalizationManager.Instance}}"
                                IsVisible="False"
                                Style="{StaticResource ModernButtonSecondary}"
                                Clicked="OnCancelClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 列表 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <CollectionView x:Name="LeavesCollectionView">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding [NoLeaveRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalTextAlignment="Center"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernListItem}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding HeaderText}"
                                               Style="{StaticResource ModernBody}"
                                               FontAttributes="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DetailText}"
                                               Style="{StaticResource ModernBodySmall}"/>
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Edit]}"
                                                    FontSize="12" HeightRequest="36" Padding="10,4"
                                                    Style="{StaticResource ModernButtonSecondary}"
                                                    Clicked="OnEditClicked" CommandParameter="{Binding Id}"/>
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Delete]}"
                                                    FontSize="12" HeightRequest="36" Padding="10,4"
                                                    Style="{StaticResource ModernButtonWarning}"
                                                    Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding [Refresh], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonSecondary}"
                    Clicked="OnRefreshClicked"
                    Margin="0,0,0,20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
