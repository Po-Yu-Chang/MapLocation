<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [MyReport], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Center">

            <Border Style="{StaticResource HeroHeader}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            BackgroundColor="#FACC15"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            WidthRequest="48" HeightRequest="48">
                        <Label Text="📊" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding [MyReport], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource HeroTitle}"/>
                        <Label x:Name="SummaryLabel" Style="{StaticResource HeroSubtitle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding [DateFilter], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource SectionTitle}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding [StartDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="StartDatePicker" Format="yyyy-MM-dd" DateSelected="OnDateChanged"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding [EndDate], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="EndDatePicker" Format="yyyy-MM-dd" DateSelected="OnDateChanged"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0"
                                Text="{Binding [QuickThisMonth], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonCompact}"
                                Clicked="OnThisMonthClicked"/>
                        <Button Grid.Column="1"
                                Text="{Binding [QuickLastMonth], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonCompact}"
                                Clicked="OnLastMonthClicked"/>
                        <Button Grid.Column="2"
                                Text="{Binding [QuickLast30Days], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonCompact}"
                                Clicked="OnLast30DaysClicked"/>
                    </Grid>

                    <Label Text="{Binding [WorkTypeFilter], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                    <HorizontalStackLayout Spacing="20">
                        <RadioButton x:Name="FilterAllRadio" GroupName="WorkTypeFilter" IsChecked="True"
                                     Content="{Binding [WorkTypeAll], Source={x:Static svc:LocalizationManager.Instance}}"
                                     CheckedChanged="OnFilterChanged"/>
                        <RadioButton x:Name="FilterOfficeRadio" GroupName="WorkTypeFilter"
                                     Content="{Binding [Office], Source={x:Static svc:LocalizationManager.Instance}}"
                                     CheckedChanged="OnFilterChanged"/>
                        <RadioButton x:Name="FilterFieldRadio" GroupName="WorkTypeFilter"
                                     Content="{Binding [Field], Source={x:Static svc:LocalizationManager.Instance}}"
                                     CheckedChanged="OnFilterChanged"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📤" FontSize="22" HorizontalOptions="Start"/>
                    <Button Text="{Binding [ExportExcel], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonAccent}"
                            Clicked="OnExportExcelClicked"/>
                    <Button Text="{Binding [ExportPdf], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonPrimary}"
                            Clicked="OnExportPdfClicked"/>
                    <Button Text="{Binding [ExportCsv], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonSecondary}"
                            Clicked="OnExportCsvClicked"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
