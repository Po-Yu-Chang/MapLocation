<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.EditCheckInPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [EditCheckInTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Center">

            <!-- Hero header -->
            <Border Style="{StaticResource HeroHeader}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Grid.Column="0"
                            BackgroundColor="#FACC15"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            WidthRequest="48" HeightRequest="48">
                        <Label Text="📝" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding [ManageCheckInRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource HeroTitle}"/>
                        <Label Text="{Binding [EditCheckInTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource HeroSubtitle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Form card -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="FormTitleLabel"
                           Text="{Binding [ManualCheckInTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>

                    <Label Text="{Binding [GeofenceLocation], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Picker x:Name="GeofencePicker"
                            Style="{StaticResource ModernPicker}"
                            Title="{Binding [GeofenceLocation], Source={x:Static svc:LocalizationManager.Instance}}"/>

                    <Label Text="{Binding [WorkType], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <HorizontalStackLayout Spacing="20">
                        <RadioButton x:Name="WorkTypeOfficeRadio"
                                     GroupName="WorkType"
                                     IsChecked="True"
                                     Content="{Binding [Office], Source={x:Static svc:LocalizationManager.Instance}}"/>
                        <RadioButton x:Name="WorkTypeFieldRadio"
                                     GroupName="WorkType"
                                     Content="{Binding [Field], Source={x:Static svc:LocalizationManager.Instance}}"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding [CheckInTimeLabel], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="CheckInDatePicker" Format="yyyy-MM-dd"/>
                            <TimePicker x:Name="CheckInTimePicker" Format="HH:mm"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Label Grid.Column="0" Text="{Binding [CheckOutTimeLabel], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        FontSize="11"
                                        HeightRequest="22" WidthRequest="22"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource ModernGray500}"
                                        Clicked="OnClearCheckOutClicked"
                                        ToolTipProperties.Text="{Binding [ClearCheckOut], Source={x:Static svc:LocalizationManager.Instance}}"/>
                            </Grid>
                            <DatePicker x:Name="CheckOutDatePicker" Format="yyyy-MM-dd"/>
                            <TimePicker x:Name="CheckOutTimePicker" Format="HH:mm"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding [Notes], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Editor x:Name="NotesEditor" HeightRequest="72" MaxLength="500"/>

                    <Label Text="{Binding [EditReason], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Entry x:Name="EditReasonEntry"
                           Placeholder="{Binding [EditReasonPlaceholder], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource ModernEntry}"
                           MaxLength="200"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                x:Name="SaveButton"
                                Text="{Binding [AddBtn], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnSaveClicked"/>
                        <Button Grid.Column="1"
                                x:Name="CancelEditButton"
                                Text="{Binding [CancelEdit], Source={x:Static svc:LocalizationManager.Instance}}"
                                IsVisible="False"
                                Style="{StaticResource ModernButtonSecondary}"
                                Clicked="OnCancelEditClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Filter + List -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{Binding [CheckInHistory], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource SectionTitle}"
                               VerticalOptions="Center"/>
                        <DatePicker Grid.Column="1" x:Name="FilterDatePicker" Format="yyyy-MM-dd" DateSelected="OnFilterDateChanged"/>
                        <Button Grid.Column="2"
                                Text="{Binding [AllDates], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonCompact}"
                                Clicked="OnAllDatesClicked"/>
                    </Grid>

                    <CollectionView x:Name="RecordsCollectionView">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding [NoCheckInRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBodySmall}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,16"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource ModernBorder}"
                                        StrokeThickness="1"
                                        Padding="0"
                                        Margin="0,3">
                                    <Grid ColumnDefinitions="4,*,Auto">
                                        <BoxView Grid.Column="0" Color="{Binding AccentColor}" />
                                        <VerticalStackLayout Grid.Column="1" Padding="14,10" Spacing="2">
                                            <Label Text="{Binding HeaderText}"
                                                   Style="{StaticResource ModernBody}"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding DetailText}"
                                                   Style="{StaticResource ModernBodySmall}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding TagsText}"
                                                   Style="{StaticResource ModernCaption}"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" Padding="0,0,10,0">
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Edit]}"
                                                    Style="{StaticResource ModernButtonCompact}"
                                                    Clicked="OnEditClicked" CommandParameter="{Binding Id}"/>
                                            <Button Text="{Binding Source={x:Static svc:LocalizationManager.Instance}, Path=[Delete]}"
                                                    BackgroundColor="{StaticResource ModernErrorLight}"
                                                    TextColor="{StaticResource ModernError}"
                                                    CornerRadius="6"
                                                    Padding="12,6"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    HeightRequest="34"
                                                    Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding [Refresh], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonSecondary}"
                    Clicked="OnRefreshClicked"
                    Margin="0,0,0,16"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
