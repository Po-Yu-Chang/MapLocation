<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [AppSettings], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="800" HorizontalOptions="Center">

            <!-- 頁面標題 -->
            <Label Text="{Binding [AppSettings], Source={x:Static svc:LocalizationManager.Instance}}"
                   Style="{StaticResource ModernH2}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <!-- 語言設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🌍" FontSize="24"/>
                        <Label Text="{Binding [LanguageSettings], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [SelectLanguage], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}"/>
                        <Picker x:Name="LanguagePicker"
                                Style="{StaticResource ModernPicker}"
                                SelectedIndexChanged="OnLanguageChanged">
                            <Picker.Items>
                                <x:String>繁體中文 (Traditional Chinese)</x:String>
                                <x:String>简体中文 (Simplified Chinese)</x:String>
                                <x:String>English</x:String>
                                <x:String>ภาษาไทย (Thai)</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 主題設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🎨" FontSize="24"/>
                        <Label Text="{Binding [ThemeSettings], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [SelectTheme], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}"/>
                        <Picker x:Name="ThemePicker"
                                Style="{StaticResource ModernPicker}"
                                SelectedIndexChanged="OnThemeChanged">
                            <Picker.Items>
                                <x:String>🌞 淺色模式</x:String>
                                <x:String>🌙 深色模式</x:String>
                                <x:String>🔄 自動 (跟隨系統)</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 位置設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📍" FontSize="24"/>
                        <Label Text="{Binding [LocationServices], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [EnableHighAccuracy], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="HighAccuracySwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnHighAccuracyToggled"/>
                        </Grid>

                        <BoxView Style="{StaticResource ModernSeparator}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [BackgroundLocationUpdates], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="BackgroundLocationSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnBackgroundLocationToggled"/>
                        </Grid>

                        <BoxView Style="{StaticResource ModernSeparator}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [AutoGeofenceDetection], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="GeofenceDetectionSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnGeofenceDetectionToggled"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 通知設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🔔" FontSize="24"/>
                        <Label Text="{Binding [NotificationSettings], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [CheckInReminder], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="CheckInNotificationSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnCheckInNotificationToggled"/>
                        </Grid>

                        <BoxView Style="{StaticResource ModernSeparator}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [GeofenceNotifications], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="GeofenceNotificationSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnGeofenceNotificationToggled"/>
                        </Grid>

                        <BoxView Style="{StaticResource ModernSeparator}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [TeamLocationNotification], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="TeamNotificationSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnTeamNotificationToggled"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Telegram 推播通知設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📱" FontSize="24"/>
                        <Label Text="{Binding [TelegramPush], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding [EnableTelegram], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    x:Name="TelegramEnabledSwitch"
                                    Style="{StaticResource ModernSwitch}"
                                    Toggled="OnTelegramEnabledToggled"/>
                        </Grid>

                        <VerticalStackLayout x:Name="TelegramConfigLayout" Spacing="12" IsVisible="False">
                            <BoxView Style="{StaticResource ModernSeparator}"/>

                            <Label Text="機器人設定" Style="{StaticResource ModernBody}" FontAttributes="Bold"/>

                            <Entry x:Name="TelegramBotTokenEntry"
                                   Placeholder="輸入 Telegram Bot Token"
                                   IsPassword="True"
                                   Style="{StaticResource ModernEntry}"/>

                            <Entry x:Name="TelegramChatIdEntry"
                                   Placeholder="輸入 Chat ID 或 @頻道名稱"
                                   Style="{StaticResource ModernEntry}"/>

                            <Border BackgroundColor="{StaticResource ModernInfoLight}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="16"
                                    Margin="0,8,0,0">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="📝 設定說明：" Style="{StaticResource ModernBody}" FontAttributes="Bold" TextColor="{StaticResource ModernInfo}"/>
                                    <Label Text="1. 在 Telegram 搜尋 @BotFather → /start → /newbot 建立機器人" Style="{StaticResource ModernCaption}"/>
                                    <Label Text="2. 取得 Bot Token（形如 123456789:AA...）" Style="{StaticResource ModernCaption}"/>
                                    <Label Text="3. 讓 Bot 能傳訊息給您：" Style="{StaticResource ModernCaption}"/>
                                    <Label Text="   • 個人：搜尋您的 Bot 名稱，按 Start" Style="{StaticResource ModernCaption}" Margin="12,0,0,0"/>
                                    <Label Text="   • 群組：把 Bot 加進群組，給他權限" Style="{StaticResource ModernCaption}" Margin="12,0,0,0"/>
                                    <Label Text="   • 頻道：把 Bot 加進頻道並設為管理員" Style="{StaticResource ModernCaption}" Margin="12,0,0,0"/>
                                    <Label Text="4. 取得 Chat ID：" Style="{StaticResource ModernCaption}"/>
                                    <Label Text="   • 開瀏覽器 GET: https://api.telegram.org/bot&lt;YOUR_BOT_TOKEN&gt;/getUpdates" Style="{StaticResource ModernCaption}" Margin="12,0,0,0"/>
                                    <Label Text="   • 找到 message.chat.id（群組/頻道通常是負數）" Style="{StaticResource ModernCaption}" Margin="12,0,0,0"/>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                <Button Grid.Column="0"
                                        x:Name="TelegramTestButton"
                                        Text="🧪 測試連線"
                                        Style="{StaticResource ModernButtonSecondary}"
                                        Clicked="OnTelegramTestClicked"/>

                                <Button Grid.Column="1"
                                        x:Name="TelegramSaveButton"
                                        Text="💾 儲存設定"
                                        Style="{StaticResource ModernButtonPrimary}"
                                        Clicked="OnTelegramSaveClicked"/>
                            </Grid>

                            <Label x:Name="TelegramStatusLabel"
                                   Text="📡 狀態: 未設定"
                                   Style="{StaticResource ModernCaption}"
                                   Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 資料庫設定卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🗄️" FontSize="24"/>
                        <Label Text="MySQL 資料庫設定" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="打卡記錄儲存至以下 MySQL 資料庫。"
                               Style="{StaticResource ModernBodySmall}"
                               TextColor="{StaticResource ModernTextSecondary}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   x:Name="DbHostEntry"
                                   Placeholder="主機位址 (Host)"
                                   Style="{StaticResource ModernEntry}"
                                   Keyboard="Url"/>
                            <Entry Grid.Column="1"
                                   x:Name="DbPortEntry"
                                   Placeholder="Port"
                                   Style="{StaticResource ModernEntry}"
                                   Keyboard="Numeric"
                                   WidthRequest="90"/>
                        </Grid>

                        <Entry x:Name="DbNameEntry"
                               Placeholder="資料庫名稱 (Database Name)"
                               Style="{StaticResource ModernEntry}"/>

                        <Entry x:Name="DbUsernameEntry"
                               Placeholder="使用者名稱 (Username)"
                               Style="{StaticResource ModernEntry}"/>

                        <Entry x:Name="DbPasswordEntry"
                               Placeholder="密碼 (Password)"
                               IsPassword="True"
                               Style="{StaticResource ModernEntry}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    x:Name="DbTestButton"
                                    Text="🔌 測試連線"
                                    Style="{StaticResource ModernButtonSecondary}"
                                    Clicked="OnDbTestClicked"/>
                            <Button Grid.Column="1"
                                    x:Name="DbSaveButton"
                                    Text="💾 儲存設定"
                                    Style="{StaticResource ModernButtonPrimary}"
                                    Clicked="OnDbSaveClicked"/>
                        </Grid>

                        <Label x:Name="DbStatusLabel"
                               Text="📡 狀態: 未驗證"
                               Style="{StaticResource ModernCaption}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 資料管理卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="💾" FontSize="24"/>
                        <Label Text="{Binding [DataManagement], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="📤 匯出資料"
                                    Style="{StaticResource ModernButtonSecondary}"
                                    Clicked="OnExportDataClicked"/>

                            <Button Grid.Column="1"
                                    Text="📥 匯入資料"
                                    Style="{StaticResource ModernButtonSecondary}"
                                    Clicked="OnImportDataClicked"/>
                        </Grid>

                        <Button Text="🗑️ 清除快取"
                                Style="{StaticResource ModernButtonWarning}"
                                Clicked="OnClearCacheClicked"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 關於資訊卡片 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="ℹ️" FontSize="24"/>
                        <Label Text="{Binding [About], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Grid.Column="0"
                                   Text="版本:"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="1.0.0"
                                   Style="{StaticResource ModernBody}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End"/>
                        </Grid>

                        <BoxView Style="{StaticResource ModernSeparator}"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Grid.Column="0"
                                   Text="建置:"
                                   Style="{StaticResource ModernBody}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="20241201"
                                   Style="{StaticResource ModernBody}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End"/>
                        </Grid>

                        <Button Text="📄 查看隱私政策"
                                Style="{StaticResource ModernButtonSecondary}"
                                Clicked="OnPrivacyPolicyClicked"
                                Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- M5: 打卡規則 / 上下班提醒 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⏰" FontSize="24"/>
                        <Label Text="打卡規則與提醒" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="需在打卡點才能打卡"
                               Style="{StaticResource ModernBody}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Row="0" Grid.Column="1"
                                x:Name="StrictGeofenceSwitch"
                                Toggled="OnStrictGeofenceToggled"/>

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="上下班時間提醒"
                               Style="{StaticResource ModernBody}"
                               VerticalOptions="Center"/>
                        <Switch Grid.Row="1" Grid.Column="1"
                                x:Name="ClockReminderSwitch"
                                Toggled="OnClockReminderToggled"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
