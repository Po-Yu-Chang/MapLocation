<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [ProfileTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource ModernPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding [Back], Source={x:Static svc:LocalizationManager.Instance}}" Clicked="OnBackClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="800" HorizontalOptions="Center">

            <Button Text="{Binding [Back], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonSecondary}"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked"/>

            <Label Text="{Binding [MyProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                   Style="{StaticResource ModernH2}"
                   HorizontalOptions="Center"/>

            <!-- Avatar -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🖼️" FontSize="24"/>
                        <Label Text="{Binding [Avatar], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Image x:Name="AvatarImage"
                           HeightRequest="120"
                           WidthRequest="120"
                           Aspect="AspectFill"
                           HorizontalOptions="Center"/>

                    <Button x:Name="ChangeAvatarButton"
                            Text="{Binding [ChangeAvatar], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonSecondary}"
                            Clicked="OnChangeAvatarClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- 基本資料 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="👤" FontSize="24"/>
                        <Label Text="{Binding [MyProfile], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Label Text="{Binding [FullName], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Entry x:Name="FullNameEntry" Style="{StaticResource ModernEntry}" MaxLength="100"/>

                    <Label Text="{Binding [EmailAddress], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Entry x:Name="EmailEntry" Keyboard="Email" Style="{StaticResource ModernEntry}" MaxLength="100"/>

                    <Label Text="{Binding [PhoneNumber], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Entry x:Name="PhoneEntry" Keyboard="Telephone" Style="{StaticResource ModernEntry}" MaxLength="50"/>

                    <Label Text="{Binding [Department], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Entry x:Name="DepartmentEntry" Style="{StaticResource ModernEntry}" MaxLength="50"/>

                    <Label Text="{Binding [Position], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <Entry x:Name="PositionEntry" Style="{StaticResource ModernEntry}" MaxLength="50"/>
                </VerticalStackLayout>
            </Border>

            <!-- 預設工作時段 -->
            <Border Style="{StaticResource ModernCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⏰" FontSize="24"/>
                        <Label Text="{Binding [WorkType], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernH4}"/>
                    </HorizontalStackLayout>

                    <Label Text="{Binding [WorkHoursStart], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <TimePicker x:Name="WorkStartPicker" Format="HH:mm" />

                    <Label Text="{Binding [WorkHoursEnd], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBodySmall}"/>
                    <TimePicker x:Name="WorkEndPicker" Format="HH:mm" />

                    <Button Text="{Binding [ResetWorkHours], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonSecondary}"
                            Clicked="OnResetWorkHoursClicked"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding [SaveProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonPrimary}"
                    Clicked="OnSaveClicked"
                    Margin="0,0,0,20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
