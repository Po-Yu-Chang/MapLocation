<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MapLocationApp.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             Title="{Binding [ProfileTitle], Source={x:Static svc:LocalizationManager.Instance}}"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Center">

            <!-- Page header -->
            <VerticalStackLayout Spacing="0" Padding="4,16,4,8">
                <Label Text="{Binding [MyProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitle}"/>
                <Label Text="{Binding [ProfileTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageSubtitle}"/>
            </VerticalStackLayout>

            <!-- Avatar card -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource ModernPrimaryLighter}"
                            StrokeShape="RoundRectangle 60"
                            Stroke="{StaticResource ModernPrimaryLight}"
                            StrokeThickness="2"
                            WidthRequest="120" HeightRequest="120"
                            HorizontalOptions="Center">
                        <Image x:Name="AvatarImage"
                               Aspect="AspectFill"
                               WidthRequest="120" HeightRequest="120"/>
                    </Border>
                    <Button Text="{Binding [ChangeAvatar], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonCompact}"
                            HorizontalOptions="Center"
                            Clicked="OnChangeAvatarClicked"/>

                    <!-- Role badge — yellow for admin, neutral for employee -->
                    <Border x:Name="RoleBadge"
                            BackgroundColor="{StaticResource ModernAccent}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            Padding="12,4"
                            HorizontalOptions="Center">
                        <Label x:Name="RoleBadgeLabel"
                               Text=""
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ModernGray900}"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Basic info -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding [MyProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>

                    <Label Text="{Binding [FullName], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Entry x:Name="FullNameEntry" Style="{StaticResource ModernEntry}" MaxLength="100"/>

                    <Label Text="{Binding [EmailAddress], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Entry x:Name="EmailEntry" Keyboard="Email" Style="{StaticResource ModernEntry}" MaxLength="100"/>

                    <Label Text="{Binding [PhoneNumber], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                    <Entry x:Name="PhoneEntry" Keyboard="Telephone" Style="{StaticResource ModernEntry}" MaxLength="50"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding [Department], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <Entry x:Name="DepartmentEntry" Style="{StaticResource ModernEntry}" MaxLength="50"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding [Position], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <Entry x:Name="PositionEntry" Style="{StaticResource ModernEntry}" MaxLength="50"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Work hours -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding [WorkType], Source={x:Static svc:LocalizationManager.Instance}}"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding [WorkHoursStart], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <TimePicker x:Name="WorkStartPicker" Format="HH:mm" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding [WorkHoursEnd], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}"/>
                            <TimePicker x:Name="WorkEndPicker" Format="HH:mm" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="{Binding [ResetWorkHours], Source={x:Static svc:LocalizationManager.Instance}}"
                            Style="{StaticResource ModernButtonCompact}"
                            HorizontalOptions="Start"
                            Margin="0,4,0,0"
                            Clicked="OnResetWorkHoursClicked"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding [SaveProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                    Style="{StaticResource ModernButtonPrimary}"
                    Clicked="OnSaveClicked"
                    Margin="0,8,0,16"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
