<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="MapLocationApp.MainPage"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16" MaximumWidthRequest="900" HorizontalOptions="Center">

            <!-- Brand wordmark + greeting -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Start">
                <Label Grid.Column="0"
                       Text="DAKA+"
                       Style="{StaticResource BrandWordmark}"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       x:Name="GreetingLabel"
                       Text="{Binding [GreetingMorning], Source={x:Static svc:LocalizationManager.Instance}}"
                       FontSize="13"
                       TextColor="{StaticResource ModernTextSecondary}"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
            </Grid>

            <!-- Tile grid: 2 columns, varied colors WYGINS+ style -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="160,160,160,160,160" RowSpacing="14" ColumnSpacing="14">

                <!-- 1. Hero: 進入打卡 (orange, full-width) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileOrange}">
                    <Grid Padding="24,20" RowDefinitions="Auto,*">
                        <!-- Plus badge top-right, can span rows so always anchored -->
                        <Border Grid.RowSpan="2"
                                Style="{StaticResource TilePlusBadge}"
                                BackgroundColor="#FFFFFF">
                            <Label Text="+" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource TileOrange}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Row 0: pin icon, contained so it never overlaps the text below -->
                        <Grid Grid.Row="0"
                              x:Name="HeroPinHost"
                              HorizontalOptions="Start"
                              WidthRequest="36" HeightRequest="44">
                            <Path Fill="#FFE5D4"
                                  Stroke="White" StrokeThickness="2"
                                  Data="M 16,2 C 9,2 4,7 4,14 C 4,22 16,38 16,38 C 16,38 28,22 28,14 C 28,7 23,2 16,2 Z"/>
                            <Ellipse Fill="{StaticResource TileOrange}"
                                     WidthRequest="8" HeightRequest="8"
                                     HorizontalOptions="Start" VerticalOptions="Start"
                                     Margin="12,10,0,0"/>
                        </Grid>

                        <!-- Row 1: text content, bottom-aligned in remaining space -->
                        <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="4">
                            <Label x:Name="TodayDateLabel"
                                   Text=""
                                   FontSize="13"
                                   TextColor="#FFE5D4"
                                   FontAttributes="Italic"/>
                            <Label Text="{Binding [EnterCheckIn], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource ScriptHeadingLarge}"
                                   TextColor="White"/>
                            <Label x:Name="TodayStatusLabel"
                                   Text="{Binding [NotCheckedInToday], Source={x:Static svc:LocalizationManager.Instance}}"
                                   FontSize="13"
                                   TextColor="#FFF5EC"/>
                        </VerticalStackLayout>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCheckInClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 2. 我的排班 (lavender) — calendar grid icon -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileLavender}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#9776B4">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Calendar: outer rounded rect + 6 small dots in 2x3 grid -->
                        <Grid Grid.Row="0"
                              HorizontalOptions="Start"
                              WidthRequest="48" HeightRequest="44"
                              ColumnDefinitions="*,*,*" RowDefinitions="14,*,*"
                              ColumnSpacing="2" RowSpacing="2">
                            <RoundRectangle Grid.RowSpan="3" Grid.ColumnSpan="3"
                                            CornerRadius="6"
                                            Stroke="White" StrokeThickness="2.5"
                                            Fill="Transparent"/>
                            <BoxView Grid.Row="0" Grid.ColumnSpan="3" Color="White" CornerRadius="0" Margin="2,2,2,0"/>
                            <Ellipse Grid.Row="1" Grid.Column="0" Fill="White" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Grid.Row="1" Grid.Column="1" Fill="White" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Grid.Row="1" Grid.Column="2" Fill="White" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Grid.Row="2" Grid.Column="0" Fill="White" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Grid.Row="2" Grid.Column="1" Fill="#9776B4" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Grid.Row="2" Grid.Column="2" Fill="White" WidthRequest="6" HeightRequest="6" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [MyShift], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeading}"
                               TextColor="White"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 3. 我的請假 (mustard) — sun icon -->
                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileMustard}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#FAEFD9">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TileMustard}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="46" HeightRequest="46">
                            <Ellipse Fill="#FAEFD9" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Path Stroke="#FAEFD9" StrokeThickness="2.5" StrokeLineCap="Round"
                                  Data="M 23,2 L 23,8 M 23,38 L 23,44 M 2,23 L 8,23 M 38,23 L 44,23 M 8,8 L 12,12 M 34,34 L 38,38 M 38,8 L 34,12 M 8,38 L 12,34"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [LeaveTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeading}"
                               TextColor="#FAEFD9"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLeaveClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 4. 報表 (pastel blue) — bar chart icon + count -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileBlue}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#E96B3C">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="48" HeightRequest="40"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="4">
                            <RoundRectangle Grid.Column="0" CornerRadius="2" Fill="{StaticResource ModernPrimary}" HeightRequest="20" VerticalOptions="End"/>
                            <RoundRectangle Grid.Column="1" CornerRadius="2" Fill="{StaticResource ModernPrimary}" HeightRequest="32" VerticalOptions="End"/>
                            <RoundRectangle Grid.Column="2" CornerRadius="2" Fill="{StaticResource ModernPrimary}" HeightRequest="14" VerticalOptions="End"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [MyReport], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeading}"
                               TextColor="{StaticResource ModernTextPrimary}"
                               VerticalOptions="End"/>

                        <Label x:Name="MonthCountLabel"
                               Grid.RowSpan="2"
                               Text="0"
                               FontSize="11"
                               TextColor="{StaticResource ModernTextSecondary}"
                               HorizontalOptions="End" VerticalOptions="Start"
                               Margin="0,12,44,0"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReportClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 5. 個人檔案 (cream) — person silhouette icon -->
                <Border Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileCream}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#A88BC6">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="44" HeightRequest="44">
                            <Ellipse Fill="#A88BC6" WidthRequest="18" HeightRequest="18"
                                     HorizontalOptions="Center" VerticalOptions="Start"
                                     Margin="0,2,0,0"/>
                            <Path Fill="#A88BC6"
                                  Data="M 4,40 C 4,28 14,24 22,24 C 30,24 40,28 40,40 Z"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [MyProfile], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeading}"
                               TextColor="{StaticResource ModernPrimary}"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 6. Admin: 打卡點管理 (orange darker) — concentric target rings -->
                <Border Grid.Row="3" Grid.Column="0"
                        x:Name="GeofencesTile"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="#B84A26">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#FAEFD9">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="#B84A26"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="44" HeightRequest="44">
                            <Ellipse Stroke="#FCD9C8" StrokeThickness="2" Fill="Transparent"
                                     WidthRequest="44" HeightRequest="44"/>
                            <Ellipse Stroke="#FCD9C8" StrokeThickness="2" Fill="Transparent"
                                     WidthRequest="28" HeightRequest="28"
                                     HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Ellipse Fill="#FAEFD9"
                                     WidthRequest="10" HeightRequest="10"
                                     HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [ManageGeofences], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeadingSmall}"
                               TextColor="#FAEFD9"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGeofencesClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 7. Admin: 編輯/補打卡 (sage green) — pencil drawn from polygons -->
                <Border Grid.Row="3" Grid.Column="1"
                        x:Name="EditRecordsTile"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource TileSage}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#FAEFD9">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TileSage}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="48" HeightRequest="48">
                            <Path Fill="#F0E0A8" Stroke="White" StrokeThickness="1.5"
                                  Data="M 8,40 L 30,18 L 36,24 L 14,46 Z"/>
                            <Path Fill="#2C1810"
                                  Data="M 8,40 L 14,46 L 6,48 Z"/>
                            <Path Fill="#E96B3C" Stroke="White" StrokeThickness="1.5"
                                  Data="M 30,18 L 36,24 L 40,20 L 34,14 Z"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [MyCheckInRecords], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeadingSmall}"
                               TextColor="White"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditRecordsClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 8. Admin: 待審核帳號 (lavender darker) -->
                <Border Grid.Row="4" Grid.Column="0"
                        x:Name="PendingApprovalsTile"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="{StaticResource ModernSecondary}">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#FAEFD9">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource ModernSecondary}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Label Grid.Row="0"
                               x:Name="PendingCountLabel"
                               Text="0"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="White"
                               FontFamily="Times New Roman"
                               HorizontalOptions="Start" VerticalOptions="Center"/>

                        <Label Grid.Row="1"
                               Text="{Binding [PendingApprovalsTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeadingSmall}"
                               TextColor="White"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPendingApprovalsClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 9. 設定 (cream variant) — gear icon -->
                <Border Grid.Row="4" Grid.Column="1"
                        Style="{StaticResource TileCard}"
                        BackgroundColor="#F0E0A8">
                    <Grid Padding="20,16" RowDefinitions="Auto,*">
                        <Border Grid.RowSpan="2" Style="{StaticResource TilePlusBadge}" BackgroundColor="#C9A03A">
                            <Label Text="+" FontSize="16" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid Grid.Row="0" HorizontalOptions="Start"
                              WidthRequest="44" HeightRequest="44">
                            <Path Fill="{StaticResource TileMustard}"
                                  Data="M 22,2 L 26,4 L 30,2 L 32,8 L 38,8 L 38,14 L 42,18 L 38,22 L 42,26 L 38,30 L 38,36 L 32,36 L 30,42 L 26,40 L 22,42 L 18,40 L 14,42 L 12,36 L 6,36 L 6,30 L 2,26 L 6,22 L 2,18 L 6,14 L 6,8 L 12,8 L 14,2 L 18,4 Z"/>
                            <Ellipse Fill="#F0E0A8" WidthRequest="14" HeightRequest="14"
                                     HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding [SettingsTitle], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ScriptHeading}"
                               TextColor="{StaticResource ModernTextPrimary}"
                               VerticalOptions="End"/>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

            </Grid>

            <Label Text="DAKA+ v1.0"
                   FontSize="10"
                   FontAttributes="Italic"
                   TextColor="{StaticResource ModernTextTertiary}"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
