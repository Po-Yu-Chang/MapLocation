<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:MapLocationApp.Services"
             x:Class="MapLocationApp.MainPage"
             Style="{StaticResource GlassPage}">

    <ContentPage.Resources>
        <ResourceDictionary Source="Resources/Styles/ModernTheme.xaml" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Brand bar: spans full screen width; inner text aligns to the same gutter as cards below. -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource ModernPrimary}"
                StrokeShape="Rectangle"
                Stroke="Transparent"
                Padding="0">
            <VerticalStackLayout Spacing="4"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Center"
                                 Padding="20,24">
                <Label Text="DAKA"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       CharacterSpacing="3"/>
                <Label x:Name="GreetingLabel"
                       Text="{Binding [GreetingMorning], Source={x:Static svc:LocalizationManager.Instance}}"
                       FontSize="13"
                       TextColor="#BFDBFE"/>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32"
                                 Spacing="16"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Center">

                <!-- Today status card — primary CTA -->
                <Border Style="{StaticResource GlassCardTinted}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="3"
                                     HeightRequest="16"
                                     Color="{StaticResource ModernPrimary}"
                                     VerticalOptions="Center"/>
                            <Label Text="{Binding [Today], Source={x:Static svc:LocalizationManager.Instance}}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0"/>
                        </HorizontalStackLayout>

                        <Label x:Name="TodayDateLabel"
                               Style="{StaticResource SectionTitle}"
                               FontSize="22"/>
                        <Label x:Name="TodayStatusLabel"
                               Text="{Binding [NotCheckedInToday], Source={x:Static svc:LocalizationManager.Instance}}"
                               Style="{StaticResource ModernBodySmall}"/>

                        <Button Text="{Binding [EnterCheckIn], Source={x:Static svc:LocalizationManager.Instance}}"
                                Style="{StaticResource ModernButtonPrimary}"
                                Clicked="OnCheckInClicked"
                                Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick stats row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding [MonthCheckIns], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Label x:Name="MonthCountLabel"
                                   Text="0"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource ModernPrimary}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding [WeekHours], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Label x:Name="WeekHoursLabel"
                                   Text="0.0"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource ModernPrimary}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Other actions -->
                <Border Style="{StaticResource GlassCard}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                            <Label Grid.Column="0" Text="{Binding [FaceRecognitionTitle], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFaceRecognitionClicked"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                            <Label Grid.Column="0" Text="{Binding [SettingsTitle], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource CardDivider}" Margin="20,0"/>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,14">
                            <Label Grid.Column="0" Text="{Binding [PrivacyTitle], Source={x:Static svc:LocalizationManager.Instance}}" Style="{StaticResource ModernBody}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource ModernGray400}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyClicked"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="MapLocation v1.0"
                       Style="{StaticResource ModernCaption}"
                       HorizontalOptions="Center"
                       Margin="0,12,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
